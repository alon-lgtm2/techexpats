---
import { getT, localizePath, LANGS, LANG_LABELS, DEFAULT_LANG, type Lang } from "../i18n";
import { ROUTES } from "../i18n/routes";

interface Props { lang?: Lang; localePaths?: Record<string, string> }
const { lang = "en", localePaths } = Astro.props;
const t = getT(lang);

// path without the locale prefix, so the switcher keeps you on the same page
const parts = Astro.url.pathname.split("/").filter(Boolean);
const basePath = (LANGS as string[]).includes(parts[0]) ? "/" + parts.slice(1).join("/") : Astro.url.pathname;
const cleanBase = basePath === "" ? "/" : basePath;

// Which languages this page actually exists in. The switcher used to build a
// link for all three unconditionally, so on a Hebrew-only page it offered
// /en/pricing and /nl/pricing, neither of which was ever built. That was true
// before the 2026-09-05 locale flip too, at different URLs. routes.ts exists
// precisely to answer this, and its own comment says advertising a URL that
// 404s is worse than advertising nothing.
const hrefFor = (l: Lang) => {
  const explicit = localePaths?.[l];
  if (explicit) return explicit;
  const c = localizePath(cleanBase, l);
  const norm = c.endsWith("/") ? c : c + "/";
  return ROUTES.has(norm) ? c : null;
};
const langHrefs = Object.fromEntries(LANGS.map((l) => [l, hrefFor(l)])) as Record<Lang, string | null>;

const extra = {
  resources: { he: "מידע שימושי", en: "Useful Information", nl: "Nuttige informatie" },
} as const;
const pick = (m: Record<string, string>) => m[lang] ?? m.en;

const links = [
  { label: t.nav.howItWorks, href: "/how-it-works" },
  { label: t.nav.careerAdvice, href: "/career-advice" },
  // Hebrew-only, because the pricing page exists only in Hebrew. Adding it to
  // the English or Dutch nav would send those readers to a 404 (2026-09-02).
  ...(lang === "he" ? [{ label: t.nav.pricing, href: "/pricing" }] : []),
  // Hebrew-only: the AI tools are written in Hebrew and coach in Hebrew,
  // so they are surfaced on the Hebrew track only (harvested from jobs.israelis.nl, 2026-07-21).
  ...(lang === "he" ? [{ label: "כלי AI", href: "/ai-tools" }] : []),
  { label: pick(extra.resources), href: "/resources" },
  { label: t.nav.about, href: "/about" },
  // The employer track. Career Advice and Hiring Insights sit next to each
  // other on purpose: the two audiences should be visible in the nav itself.
  { label: t.nav.hiringInsights, href: "/hiring-insights" },
  { label: t.nav.forCompanies, href: "/for-companies", employer: true },
];
---

<header class="nav">
  <div class="container nav-inner">
    <a href={localizePath("/", lang)} class="brand">
      TechExpats<span class="brand-mark">.</span>
      <span class="brand-sub">Career Moves</span>
    </a>

    <nav class="links" aria-label="Primary">
      {links.map((l) => <a href={localizePath(l.href, lang)} class:list={{ employer: l.employer }}>{l.label}</a>)}
    </nav>

    <div class="nav-right">
      <div class="langs" role="group" aria-label="Language">
        {LANGS.map((l) => (
          langHrefs[l] ? (
            <a href={langHrefs[l]!} class:list={["lang", { active: l === lang }]} hreflang={l}>{LANG_LABELS[l]}</a>
          ) : (
            <span class="lang off" aria-disabled="true" title={t.nav.langMissing}>{LANG_LABELS[l]}</span>
          )
        ))}
      </div>
      <button class="ground" id="ground" type="button" aria-label={t.nav.scheme} title={t.nav.scheme}>
        <svg class="sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.2" /><path d="M12 2.4v2.2M12 19.4v2.2M2.4 12h2.2M19.4 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6" />
        </svg>
        <svg class="moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2z" />
        </svg>
      </button>
      <a href={localizePath("/book", lang)} class="btn btn-primary nav-cta">{t.cta.book} <span class="arrow">&rarr;</span></a>
      <button class="burger" aria-label="Menu" aria-expanded="false" id="burger">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile" id="mobile-menu" aria-label="Mobile">
    {links.map((l) => <a href={localizePath(l.href, lang)}>{l.label}</a>)}
    <a href={localizePath("/book", lang)} class="mobile-cta">{t.cta.book} <span class="arrow">&rarr;</span></a>
  </nav>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner { display: flex; align-items: center; gap: 1.5rem; height: 4.5rem; }
  .brand {
    font-family: var(--display); font-weight: var(--display-weight);
    font-size: 1.2rem; letter-spacing: -0.03em; color: var(--ink);
    display: flex; flex-direction: column; line-height: 1; white-space: nowrap;
  }
  .brand-mark { display: none; }
  .brand-sub {
    font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--ink-3); margin-top: 0.3rem; font-weight: 400;
  }
  /* nowrap, because eight links across were each breaking onto two lines in
     English ("How It / Works", "For / Companies") and reading as a broken
     header. The gap gives back the room. */
  .links { display: none; gap: 1.1rem; margin-inline-start: auto; font-size: 0.86rem; color: var(--ink-2); white-space: nowrap; }
  .links a:hover { color: var(--accent-ink); }
  /* the employer route, marked so a business buyer can find it at a glance */
  .links a.employer { color: var(--ink); font-weight: 600; }
  .links a.employer::before { content: "/ "; color: var(--accent); font-family: var(--mono); }

  .nav-right { display: flex; align-items: center; gap: 0.9rem; margin-inline-start: auto; }
  .langs { display: flex; gap: 0.15rem; }
  .lang {
    font-family: var(--mono); font-size: 0.8rem; font-weight: 500; letter-spacing: 0.05em;
    padding: 0.25rem 0.45rem; color: var(--ink-3);
  }
  .lang:hover { color: var(--ink); }
  .lang.active { color: var(--accent); font-weight: 500; }
  /* A language this page was never written in. Shown, so the switcher keeps
     its shape and the reader can see the page is single language, but not a
     link, because there is nothing to link to. */
  .lang.off { color: var(--ink-3); opacity: 0.4; cursor: default; }
  .nav-cta { padding: 0.55rem 1rem; font-size: 0.8rem; }

  /* The light/dark control. The icon shows what you would switch TO, which is
     the convention people already read without thinking. */
  .ground {
    display: flex; align-items: center; justify-content: center;
    width: 2rem; height: 2rem; flex: none;
    background: none; border: 1px solid var(--line); color: var(--ink-2);
    cursor: pointer; border-radius: var(--radius-btn);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .ground:hover { color: var(--accent-ink); border-color: var(--accent); }
  .ground svg { display: none; }
  :global([data-theme="instrument"]) .ground .sun { display: block; }
  :global([data-theme="instrument-light"]) .ground .moon { display: block; }
  /* On the four legacy directions there is no twin to switch to, so the
     control has nothing to say and stays hidden rather than lying. */
  .ground { display: none; }
  :global([data-theme^="instrument"]) .ground { display: flex; }

  .burger {
    display: flex; flex-direction: column; gap: 5px; justify-content: center;
    width: 2.4rem; height: 2.4rem; background: none; border: 1px solid var(--line); cursor: pointer;
  }
  .burger span { display: block; width: 1.1rem; height: 2px; background: var(--ink); margin-inline: auto; transition: transform .2s ease; }

  .mobile { display: none; flex-direction: column; padding: 0.5rem var(--pad) 1.25rem; border-bottom: 1px solid var(--line); }
  .mobile.open { display: flex; }
  .mobile a { padding: 0.7rem 0; font-size: 1rem; color: var(--ink-2); border-bottom: 1px solid var(--line-soft); }
  .mobile .mobile-cta { color: var(--accent); font-weight: 600; border-bottom: 0; }

  @media (min-width: 1120px) {
    .links { display: flex; }
    .nav-right { margin-inline-start: 0; }
    .burger { display: none; }
  }
  @media (max-width: 1119px) {
    .nav-cta { display: none; }
  }
</style>

<script>
  // Light or dark ground. Stored under the same key the pre-paint script in
  // Base.astro reads, and written only as one of the two values it accepts.
  const g = document.getElementById("ground");
  g?.addEventListener("click", () => {
    const el = document.documentElement;
    const next = el.getAttribute("data-theme") === "instrument-light" ? "instrument" : "instrument-light";
    el.setAttribute("data-theme", next);
    try { localStorage.setItem("te-ground", next); } catch (e) { /* nothing to do */ }
  });

  const b = document.getElementById("burger");
  const m = document.getElementById("mobile-menu");
  b?.addEventListener("click", () => {
    const open = m?.classList.toggle("open");
    b.setAttribute("aria-expanded", String(!!open));
  });
</script>
