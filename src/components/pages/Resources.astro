---

<Nav lang={lang} />

<section class="hero section">
  <div class="container">
    <span class="eyebrow">{c.eyebrow}</span>
    <h1 class="display-xl">{c.h1}</h1>
    <p class="lead">{c.sub}</p>
  </div>
</section>

<!-- NEWS -->
<section class="section alt">
  <div class="container">
    <article class="news">
      <div class="news-meta">
        <span class="label k">{c.newsKicker}</span>
        <span class="label">{c.newsDate}</span>
      </div>
      <h2 class="display-md">{c.newsTitle}</h2>
      <p class="news-body">{c.newsBody}</p>
      <ul class="points">{c.newsPoints.map((p) => <li>{p}</li>)}</ul>
      <p class="take">{c.newsTake}</p>
