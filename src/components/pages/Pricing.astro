// ---------------------------------------------------------------------------
// BOOKING AND PAYMENT
// Alon creates these in Calendly and Stripe and pastes the URLs here. Nothing
// on this page charges anyone until real URLs replace the placeholders below.
// The scheduler is for the orientation call only; everything else is paid
// first and scheduled afterwards, by mail.
// One set of links for all three languages: /pricing, /en/pricing and
// /nl/pricing sell the same things at the same prices (2026-10-20).
// ---------------------------------------------------------------------------
const LINKS = {
  calendlyOrientation: "https://calendly.com/agildoni/new-meeting", // "שעת ייעוץ", שעה, 190 יורו, נגבה בתוך Calendly
  payOrientation: "",      // לא בשימוש. התשלום על השיחה נגבה בתוך Calendly
  payWorkshop: "https://buy.stripe.com/bJe6oI6J6h1I7RS6UacEw01", // 60
  paySevenADay: "https://buy.stripe.com/00wfZi1oM5j0dcc4M2cEw06", // 360
  payEmployers: "https://buy.stripe.com/eVq00kaZm4eW3BCbaqcEw05", // 35
  payProfile: "https://buy.stripe.com/fZu9AU9VifXE0pqfqGcEw03", // 740, ישיבת עבודה
  // Bank of hours, decided with Alon 2026-10-05. The two hour bank reuses the old 420
  // candidacy link: same price, but the Stripe product still carries the old name, so
  // rename it in Stripe. Five and ten hours have no Stripe link yet; until Alon pastes
  // one here, their buttons open WhatsApp with the purchase pre-written (see buyLink).
  // Repriced with Alon 2026-10-20: 590 / 1.390 / 2.590, so an hour from a bank never costs less
  // than the 190 consultation hour. The old 420 Stripe link (9B614o7NacLsb446UacEw02) charges
  // 420 and is therefore unhooked: all three tiers open WhatsApp until new links are pasted here.
  payBank2: "",  // 590, 2 שעות
  payBank5: "",  // 1.390, 5 שעות
  payBank10: "", // 2.590, 10 שעות
  // Retired from the page 2026-10-05, kept for the record: the 1.870 end to end
  // (clients in flight keep their terms) at https://buy.stripe.com/9B69AU0kI8vcegg2DUcEw04
};
// iDEAL is enabled in Stripe payment method settings, not per link. Stripe
// surfaces it first for buyers in the Netherlands, which is most of the book:
// roughly half the invoices are NL-resident, many of them Israelis living here.
const ready = (u: string) => (u && u.length > 0 ? u : "#");
// A bank tier without a Stripe link yet still sells: the button opens WhatsApp with
// the request written, rather than a dead "#". The English and Dutch pages pre-write
// the message in English, because Alon reads it and he does not read Dutch.
const buyLink = (key: string, what: string) => {
  const u = (LINKS as Record<string, string>)[key];
  const text = lang === "he"
    ? `היי אלון, אני רוצה לרכוש בנק של ${what}`
    : `Hi Alon, I would like to buy a bank of ${what}`;
  return u && u.length > 0
    ? u
    : "https://wa.me/31644295691?text=" + encodeURIComponent(text);
};

// Real reviews, pulled from src/data/testimonials.ts so the page can never
// quote something that is not on the site.
const byName = (n: string) => testimonials.find((t) => t.name === n);
const q = (n: string) => {
  const qq = byName(n)?.quote as Record<string, string> | undefined;
  return qq?.[lang] ?? qq?.en ?? "";
};
const role = (n: string) => byName(n)?.role ?? "";
const avatar = (n: string) => byName(n)?.avatar ?? "";
const short = (s: string, max = 260) => (s.length > max ? s.slice(0, s.lastIndexOf(" ", max)) + "…" : s);

// ---------------------------------------------------------------------------
// THE COPY, per language. Prices and links are shared; only the words differ.
// Until 2026-10-20 this page was Hebrew only, so an English or Dutch reader
// searching for what career coaching in the Netherlands costs found nothing.
// The three self-serve products stay on the Hebrew page only: the recorded
// workshop and the app are in Hebrew, and the employers database is the
// Israeli companies in the Netherlands. The English and Dutch pages sell the
// consulting ladder, which is delivered in all three languages.
// ---------------------------------------------------------------------------
type Tier = { hours: string; price: string; pay: string };
type Service = { label: string; title: string; price: string; pay: string; entry: boolean; from?: boolean; tiers?: Tier[]; items: string[] };
type Copy = {
  eyebrow: string; h1a: string; h1b: string; lead: string; heroCta: string; heroNote: string;
  portraitAlt: string; portraitName: string; portraitCap: string;
  cur: string; from: string; buy: string; buyDirect: string; bookCall: string;
  productsEyebrow?: string; productsLead?: string;
  startEyebrow?: string; startHeading?: string; startBody?: string[]; startMore?: string;
  svcEyebrow: string; svcLead: string; services: Service[]; why: string; vat: string;
  stageAlt: string; stageEyebrow: string; stageBody: string;
  schedEyebrow: string; schedHeading: string; schedBody: string; schedPlaceholder: string;
  names: Record<string, string>;
  promiseEyebrow: string; stat1: string; stat2: string; promise1: string; promise2: string;
  factsEyebrow: string; facts: string[];
  tHeading: string; tSub: string;
};

