const C: Copy = lang === "en" ? EN : lang === "nl" ? NL : HE;
const SERVICES = C.services;
const who = (n: string) => C.names[n] ?? n;

const PRODUCTS = lang !== "he" ? [] : [
  {
    label: "הסדנה המוקלטת",
    title: "לראות איך נראה חיפוש עבודה שעובד.",
    price: "60",
    pay: "payWorkshop",
    items: [
