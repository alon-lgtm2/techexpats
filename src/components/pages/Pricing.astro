---

<Nav lang={lang} />

<section class="hero section">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">{C.eyebrow}</span>
      <h1 class="display-xl">{C.h1a}<em>{C.h1b}</em></h1>
      <p class="lead">{C.lead}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={ready(LINKS.calendlyOrientation || LINKS.payOrientation)}>{C.heroCta}</a>
        <p class="hero-cta-note">{C.heroNote}</p>
      </div>
    </div>
    <figure class="hero-portrait">
      <img src="/alon-portrait.jpg" alt={C.portraitAlt} width="900" height="1125" />
      <figcaption>{C.portraitName}<span>{C.portraitCap}</span></figcaption>
    </figure>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <div class="split">

      {PRODUCTS.length > 0 ? (
      <div class="col">
        <span class="eyebrow">{C.productsEyebrow}</span>
        <p class="col-lead">{C.productsLead}</p>
        <div class="rows">
          {PRODUCTS.map((p) => (
            <article class="row">
              <span class="label">{p.label}</span>
              <div class="rhead">
                <h3>{p.title}</h3>
                <p class="price-line"><span class="price">{p.price}</span><span class="cur">{C.cur}</span></p>
              </div>
              <ul class="items">{p.items.map((i) => <li>{i}</li>)}</ul>
              <a class="buy" href={ready(LINKS[p.pay as keyof typeof LINKS])}>{C.buy}</a>
            </article>
          ))}
        </div>
      </div>
      ) : (
      <div class="col">
        <span class="eyebrow">{C.startEyebrow}</span>
        <h2 class="display-md start-h">{C.startHeading}</h2>
        {C.startBody?.map((para) => <p class="body">{para}</p>)}
        <p class="body"><a class="buy" href={localizePath("/book", lang)}>{C.startMore}</a></p>
      </div>
      )}

      <div class="col">
        <span class="eyebrow">{C.svcEyebrow}</span>
        <p class="col-lead" set:html={C.svcLead} />
        <div class="rows">
          {SERVICES.map((p) => (
            <article class={p.entry ? "row entry" : "row"}>
              <span class="label">{p.label}</span>
              <div class="rhead">
                <h3>{p.title}</h3>
                <p class="price-line">{p.from && <span class="cur">{C.from}</span>}<span class="price">{p.price}</span><span class="cur">{C.cur}</span></p>
              </div>
              <ul class="items">{p.items.map((i) => <li>{i}</li>)}</ul>
              {p.tiers
                ? <ul class="tiers">{p.tiers.map((t) => (
                    <li>
                      <span class="t-h">{t.hours}</span>
                      <span class="t-p"><span class="price t-price">{t.price}</span><span class="cur">{C.cur}</span></span>
                      <a class="buy" href={buyLink(t.pay, t.hours)}>{C.buy}</a>
                    </li>
                  ))}</ul>
                : p.entry
                  ? <a class="buy" href={ready(LINKS.calendlyOrientation)}>{C.bookCall}</a>
                  : <a class="buy" href={ready(LINKS[p.pay as keyof typeof LINKS])}>{C.buyDirect}</a>}
            </article>
          ))}
        </div>
        <a class="btn btn-primary svc-cta" href={ready(LINKS.calendlyOrientation)}>{C.heroCta}</a>
        <p class="why">{C.why}</p>
      </div>

    </div>
    <p class="vat-note" set:html={C.vat} />
  </div>
</section>

<!-- STAGE BAND.
     Added 2026-09-04 at Alon's request. NOTE FOR ANYONE EDITING: this is the
     SAME photograph as the homepage band and the About page, at a tighter
     1400x349 crop rather than 1600x554. It is carried as its own asset because
     the letterbox reads differently, but it is one shot doing three jobs. The
     caption is deliberately unlike the homepage one so the repeat is not
     obvious. Replace it the moment a second usable working photo exists;
     public/README.md lists what to shoot. -->
<figure class="stage">
  <img src="/alon-stage-wide.jpg" alt={C.stageAlt} width="1400" height="349" loading="lazy" />
  <figcaption class="container">
    <span class="eyebrow">{C.stageEyebrow}</span>
    <p>{C.stageBody}</p>
  </figcaption>
</figure>

<!-- REVIEW -->
<section class="section quote-sec">
  <div class="container">
    <blockquote class="pull">
      <p>{short(q("Eva Bishara Khoury"), 300)}</p>
      <cite><img src={avatar("Eva Bishara Khoury")} alt="" loading="lazy" /><span class="who">{who("Eva Bishara Khoury")}<span>{role("Eva Bishara Khoury")}</span></span></cite>
    </blockquote>
  </div>
</section>

<!-- SCHEDULER -->
<section class="section alt">
  <div class="container">
    <div class="split">
      <div class="col">
        <span class="eyebrow">{C.schedEyebrow}</span>
        <h2 class="display-md">{C.schedHeading}</h2>
        <p class="body">{C.schedBody}</p>
        {LINKS.calendlyOrientation
          ? <div class="calendly-inline-widget" data-url={LINKS.calendlyOrientation} style="min-width:320px;height:660px;"></div>
          : <p class="placeholder">{C.schedPlaceholder}</p>}
      </div>
      <div class="col">
        <blockquote class="pull small">
          <p>{short(q("Reshef Katz"), 220)}</p>
          <cite><img src={avatar("Reshef Katz")} alt="" loading="lazy" /><span class="who">{who("Reshef Katz")}<span>{role("Reshef Katz")}</span></span></cite>
        </blockquote>
        <blockquote class="pull small">
          <p>{short(q("Yair Sepunaru"), 220)}</p>
          <cite><img src={avatar("Yair Sepunaru")} alt="" loading="lazy" /><span class="who">{who("Yair Sepunaru")}<span>{role("Yair Sepunaru")}</span></span></cite>
        </blockquote>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="split">
      <div class="col">
        <span class="eyebrow">{C.promiseEyebrow}</span>
        <div class="stats">
          <div><span class="fig">70%</span><span class="cap">{C.stat1}</span></div>
          <div><span class="fig">~85%</span><span class="cap">{C.stat2}</span></div>
        </div>
        <p class="body">{C.promise1}</p>
        <p class="body" set:html={C.promise2} />
      </div>
      <div class="col">
        <span class="eyebrow">{C.factsEyebrow}</span>
        <ul class="facts">
          {C.facts.map((f) => <li set:html={f} />)}
        </ul>
      </div>
    </div>
  </div>
</section>

{LINKS.calendlyOrientation && <script is:inline async src="https://assets.calendly.com/assets/external/widget.js"></script>}

<Testimonials lang={lang} limit={9} source="coaching" heading={C.tHeading} sub={C.tSub} />

<ProofWall lang={lang} />

<CTA lang={lang} />
<Footer lang={lang} />

<style>
  .alt { background: var(--paper-2); }
  .hero { padding-block: calc(var(--section) * 0.62) calc(var(--section) * 0.4); }
  .hero-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center; }
  /* The page carried no photograph at all, and the hero was one narrow column
     of text with the other half of the width empty (Alon, 2026-09-04). */
  .hero-portrait { margin: 0; position: relative; max-width: 22rem; }
  /* height: auto is load-bearing. The width/height attributes stay on the tag
     so the browser reserves the space and the page does not jump, but an HTML
     height attribute is a used value and it silently beats aspect-ratio, which
     is why the portrait first rendered 352 wide by its full 1125 tall. */
  .hero-portrait img { width: 100%; height: auto; aspect-ratio: 4/5; object-fit: cover; object-position: center top; filter: grayscale(1) contrast(1.04); }
  .hero-portrait figcaption {
    position: absolute; bottom: 0; inset-inline-start: 0; background: var(--accent); color: var(--on-accent);
    font-size: 0.78rem; font-weight: 600; padding: 0.5rem 0.9rem; line-height: 1.3;
  }
  .hero-portrait figcaption span { display: block; font-weight: 400; opacity: 0.85; font-size: 0.72rem; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.45fr 0.8fr; gap: 3.5rem; } }
  /* Hebrew has no italic. The browser was synthesising an oblique on Heebo,
     which is what made "וייעוץ." look wrong in the screenshot Alon sent.
     Colour carries the emphasis instead. */
  .hero h1 em { font-style: normal; color: var(--accent); }
  .hero .lead { max-width: 60ch; margin-top: 1.4rem; }
  .body { color: var(--ink-2); margin: 0 0 1rem; }

  .split { display: grid; grid-template-columns: 1fr; gap: 3rem; }
  @media (min-width: 900px) { .split { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .start-h { margin: 0.6rem 0 1.2rem; max-width: 22ch; }
  .col-lead { color: var(--ink-3); font-size: 0.95rem; margin: 0.6rem 0 1.6rem; }

  .rows { border-top: 1px solid var(--ink); }
  .row { padding: 1.4rem 0 1.5rem; border-bottom: 1px solid var(--line); }
  .row.entry { border-inline-start: 2px solid var(--accent); padding-inline-start: 1.1rem; }
  .row .label { color: var(--ink-3); }
  .rhead { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-top: 0.35rem; }
  .row h3 { font-family: var(--display); font-weight: var(--display-weight); font-size: 1.28rem; margin: 0; color: var(--ink); }
  .price-line { display: flex; align-items: baseline; gap: 0.4rem; margin: 0; white-space: nowrap; }
  .price { font-family: var(--mono); font-size: 1.55rem; font-weight: 500; line-height: 1; font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate; }
  .cur { font-size: 0.85rem; color: var(--ink-3); font-weight: 500; }

  .items { list-style: none; display: grid; gap: 0.45rem; margin: 0.85rem 0 0; padding: 0; font-size: 0.89rem; }
  .items li { position: relative; padding-inline-start: 0.95rem; color: var(--ink-2); }
  .items li::before { content: ""; position: absolute; inset-inline-start: 0; top: 0.76em; width: 6px; height: 1px; background: var(--ink-3); }

  .buy { display: inline-block; margin-top: 0.9rem; font-size: 0.85rem; font-weight: 600; color: var(--accent-ink); text-decoration: none; border-bottom: 1px solid var(--accent); padding-bottom: 2px; }
  .buy:hover { color: var(--ink); border-color: var(--ink); }
  .tiers { list-style: none; margin: 1rem 0 0; padding: 0; border-top: 1px solid var(--line); }
  .tiers li { display: flex; align-items: baseline; gap: 1rem; padding: 0.65rem 0; border-bottom: 1px solid var(--line); }
  .t-h { font-weight: 600; color: var(--ink); min-width: 5.5rem; }
  .t-p { display: flex; align-items: baseline; gap: 0.35rem; margin-inline-start: auto; }
  .t-price { font-size: 1.2rem; }
  .tiers .buy { margin-top: 0; }
  .why { margin: 1.4rem 0 0; padding-inline-start: 1.1rem; border-inline-start: 2px solid var(--line); color: var(--ink-3); font-size: 0.89rem; }
  .vat-note { margin: 2rem 0 0; font-size: 0.84rem; color: var(--ink-3); }

  .hero-cta { margin-top: 2.2rem; }
  .hero-cta-note { margin: 0.9rem 0 0; color: var(--ink-3); font-size: 0.92rem; max-width: 52ch; }
  .svc-cta { margin-top: 1.6rem; }
  /* stage band */
  .stage { margin: 0; position: relative; background: #0c0c0c; }
  .stage img { width: 100%; height: auto; aspect-ratio: 1400 / 349; object-fit: cover; filter: grayscale(1) contrast(1.05); }
  :global([data-theme="instrument"]) .stage img { filter: grayscale(1) contrast(1.05) brightness(0.72); }
  .stage figcaption { position: absolute; inset-inline: 0; bottom: 0; padding-block: 1.3rem; }
  .stage figcaption::before {
    content: ""; position: absolute; inset: -3.5rem 0 0 0; pointer-events: none;
    background: linear-gradient(to top, rgba(0,0,0,0.85), rgba(0,0,0,0));
  }
  .stage .eyebrow { position: relative; color: color-mix(in srgb, #fff 72%, transparent); }
  .stage p { position: relative; color: #fff; margin-top: 0.45rem; max-width: 58ch; font-size: 0.93rem; line-height: 1.6; }
  @media (max-width: 700px) { .stage img { aspect-ratio: 3 / 2; } .stage p { font-size: 0.84rem; } }

  .quote-sec { padding-block: calc(var(--section) * 0.5); }
  .pull { margin: 0; max-width: 62ch; }
  .pull p { font-family: var(--display); font-weight: var(--display-weight); font-size: clamp(1.25rem, 2.4vw, 1.75rem); line-height: 1.4; color: var(--ink); margin: 0; }
  .pull cite { display: flex; align-items: center; gap: 0.75rem; margin-top: 1.2rem; font-style: normal; font-size: 0.88rem; color: var(--ink-2); font-weight: 600; }
  .pull cite img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; flex: none; }
  .pull cite .who { display: block; }
  .pull cite span { display: block; color: var(--ink-3); font-weight: 400; }
  .pull.small { margin-bottom: 2.2rem; }
  .pull.small p { font-size: clamp(1.05rem, 1.8vw, 1.25rem); }

  .placeholder { border: 1px dashed var(--ink-3); padding: 1.5rem; color: var(--ink-3); font-size: 0.9rem; }

  .stats { display: flex; gap: 2.2rem; flex-wrap: wrap; margin: 1.2rem 0 1.3rem; }
  .stats > div { display: flex; flex-direction: column; gap: 0.2rem; }
  .fig { font-family: var(--mono); font-size: 1.8rem; font-weight: 500; line-height: 1; direction: ltr; unicode-bidi: isolate; }
  .cap { font-size: 0.84rem; color: var(--ink-3); }
  .facts { list-style: none; display: grid; gap: 0.55rem; margin: 1.2rem 0 0; padding: 0; }
  .facts li { position: relative; padding-inline-start: 1.1rem; color: var(--ink-2); font-size: 0.93rem; }
  .facts li::before { content: ""; position: absolute; inset-inline-start: 0; top: 0.78em; width: 8px; height: 1px; background: var(--ink-3); }
</style>
