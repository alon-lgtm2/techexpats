      { title: "גישה בסיסמה", text: "המאגר מתעדכן וכולל חברות ישראליות עם פעילות בהולנד." },
      { title: "פרטים לכל חברה", text: "ערים, כתובות, סוגי תפקידים וקישור לעמוד הקריירה. תוכלו לבחור חברה באזור שלכם ולבדוק משרות ישירות אצלה." },
    ],
  },
  {
    label: "שבע ביום (Seven a Day)",
    title: "האפליקציה לניהול חיפוש עבודה",
    price: 360,
    pay: "paySevenADay",
    duration: "שלושה חודשי גישה כלולים במחיר. אחריהם תוכלו לבחור להמשיך ב־29 יורו לחודש ולבטל בכל חודש.",
    items: [
      { title: "יומן חיפוש יומי", text: "תכננו שבע פעולות ביום, סמנו מה ביצעתם ובחרו במה להתחיל מחר." },
      { title: "מעקב אחר פניות", text: "תעדו למי פניתם, מה ענו ומה הצעד הבא. תוכלו להשהות פנייה או לשמור חברה להמשך." },
      { title: "המאגר והסדנה", text: "המנוי כולל גם את מאגר המעסיקים הישראליים בהולנד ואת הסדנה המוקלטת על חיפוש עבודה." },
    ],
  },
];
---

<Nav lang={lang} />

<section class="hero section">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">{C.eyebrow}</span>
      <h1 class="display-xl">{C.h1a}<em>{C.h1b}</em></h1>
      <p class="lead">{C.lead}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#coaching">{C.heroCta}</a>
      </div>
    </div>
    <figure class="hero-portrait">
      <img src="/alon-portrait.jpg" alt={C.portraitAlt} width="900" height="1125" />
      <figcaption>{C.portraitName}<span>{C.portraitCap}</span></figcaption>
    </figure>
  </div>
</section>

<section class="section alt" id="coaching" aria-labelledby="coaching-heading">
  <div class="container">
    <h2 class="display-md" id="coaching-heading">{C.svcHeading}</h2>
    <p class="col-lead">{C.svcLead}</p>
    <div class="coaching-grid">
      {services.map((service) => (
        <article class:list={["coaching-card", { featured: service.featured }]}>
          <span class="label">{service.label}</span>
          <h3>{service.title}</h3>
          <p class="price-line"><bdi class="price">{price(service.price)}</bdi> <span class="cur">{C.exclVat}</span></p>
          <VatTotal lang={lang} net={service.price} />
          <OfferScope lang={lang} kind="duration" duration={service.duration} items={service.items} />
          {service.review?.pricingExcerpt && (
            <figure class="buyer-quote">
              <blockquote>{service.review.pricingExcerpt[lang]}</blockquote>
              <figcaption><bdi>{service.review.name}</bdi></figcaption>
            </figure>
          )}
          {"longerSession" in service && service.longerSession && (
            <p class="longer-session">
              <a class="buy" href={whatsapp(service.longerSession.message)}>{service.longerSession.action}</a>
            </p>
          )}
          <a class:list={["btn", { "btn-primary": service.featured, "btn-ghost": !service.featured }]} href={service.href} aria-label={service.action + " · " + service.title}>{service.action}</a>
        </article>
      ))}
    </div>
    <p class="vat-note">{C.vat}</p>
  </div>
</section>

{PRODUCTS.length > 0 ? (
  <section class="section">
    <div class="container">
      <h2 class="display-md">{C.productsEyebrow}</h2>
      <p class="col-lead">{C.productsLead}</p>
      <div class="product-grid">
        {PRODUCTS.map((product) => (
          <article class="row">
            <span class="label">{product.label}</span>
            <h3>{product.title}</h3>
            <p class="price-line"><bdi class="price">{price(product.price)}</bdi> <span class="cur">{C.exclVat}</span></p>
            <VatTotal lang={lang} net={product.price} />
            <OfferScope lang={lang} kind="access" duration={product.duration} items={product.items} />
            <a class="buy product-action" href={LINKS[product.pay as keyof typeof LINKS]} aria-label={"להזמנה · " + product.title}>להזמנה</a>
          </article>
        ))}
      </div>
    </div>
  </section>
) : (
  <section class="section audience">
    <div class="container split">
      <div>
        <span class="eyebrow">{C.startEyebrow}</span>
        <h2 class="display-md start-h">{C.startHeading}</h2>
      </div>
      <div>{C.startBody?.map((para) => <p class="body">{para}</p>)}</div>
    </div>
  </section>
)}

<!-- STAGE BAND.
     Added 2026-09-04 at Alon's request. NOTE FOR ANYONE EDITING: this is the
     SAME photograph as the homepage band and the About page, at a tighter
     1400x349 crop rather than 1600x554. It is carried as its own asset because
     the letterbox reads differently, but it is one shot doing three jobs. The
     caption is deliberately unlike the homepage one so the repeat is not
     obvious. Replace it the moment a second usable working photo exists;
     public/README.md lists what to shoot. -->
<figure class="stage">
  <img src="/alon-stage-wide.jpg" alt={C.stageAlt} width="1400" height="349" loading="lazy" />
  <figcaption class="container">
    <span class="eyebrow">{C.stageEyebrow}</span>
    <p>{C.stageBody}</p>
  </figcaption>
</figure>

<!-- SCHEDULER -->
<section class="section alt" id="book-diagnosis">
  <div class="container">
    <div class="split">
      <div class="col">
        <span class="eyebrow">{C.schedEyebrow}</span>
        <h2 class="display-md">{C.schedHeading}</h2>
        <p class="body">{C.schedBody}</p>
        <ConsultationPayment lang={lang} />
        <a class="buy booking-link" href={LINKS.calendlyOrientation}>{C.diagnosis.action}</a>
        <div class="calendly-inline-widget booking-widget" data-url={LINKS.calendlyOrientation}></div>
      </div>
      <div class="col">
        <blockquote class="pull small">
          <p>{short(q("Reshef Katz"), 220)}</p>
          <cite><img src={avatar("Reshef Katz")} alt="" loading="lazy" /><span class="who">{who("Reshef Katz")}<span>{role("Reshef Katz")}</span></span></cite>
        </blockquote>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="split">
      <div class="col">
        <span class="eyebrow">{C.promiseEyebrow}</span>
        <p class="body">{C.promise1}</p>
        <p class="body" set:html={C.promise2} />
      </div>
      <div class="col">
        <span class="eyebrow">{C.factsEyebrow}</span>
        <ul class="facts">
          {C.facts.map((f) => <li set:html={f} />)}
        </ul>
      </div>
    </div>
  </div>
</section>

<script is:inline async src="https://assets.calendly.com/assets/external/widget.js"></script>

<Testimonials lang={lang} limit={3} source="coaching" excludeNames={["Eva Bishara Khoury", "Reshef Katz", ...services.map((service) => service.review?.name ?? "")]} heading={C.tHeading} sub={C.tSub} />

<ProofWall lang={lang} />

<CTA lang={lang} />
<Footer lang={lang} />

<style>
  .alt { background: var(--paper-2); }
  .hero { padding-block: calc(var(--section) * 0.62) calc(var(--section) * 0.4); }
  .hero-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center; }
  /* The page carried no photograph at all, and the hero was one narrow column
     of text with the other half of the width empty (Alon, 2026-09-04). */
  .hero-portrait { margin: 0; position: relative; max-width: 17rem; }
  /* height: auto is load-bearing. The width/height attributes stay on the tag
     so the browser reserves the space and the page does not jump, but an HTML
     height attribute is a used value and it silently beats aspect-ratio, which
     is why the portrait first rendered 352 wide by its full 1125 tall. */
  .hero-portrait img { width: 100%; height: auto; aspect-ratio: 4/5; object-fit: cover; object-position: center top; filter: grayscale(1) contrast(1.04); }
  .hero-portrait figcaption {
    position: absolute; bottom: 0; inset-inline-start: 0; background: var(--accent); color: var(--on-accent);
    font-size: 0.78rem; font-weight: 600; padding: 0.5rem 0.9rem; line-height: 1.3;
  }
  .hero-portrait figcaption span { display: block; font-weight: 400; opacity: 0.85; font-size: 0.72rem; }
  @media (min-width: 760px) {
    .hero-grid { grid-template-columns: 1.45fr 0.8fr; gap: 3.5rem; }
    .hero-portrait { justify-self: end; }
  }
  @media (max-width: 759px) { .hero-portrait { display: none; } }
  /* Hebrew has no italic. The browser was synthesising an oblique on Heebo,
     which is what made "וייעוץ." look wrong in the screenshot Alon sent.
     Colour carries the emphasis instead. */
  .hero h1 em { font-style: normal; color: var(--accent); }
  .hero .lead { max-width: 60ch; margin-top: 1.4rem; }
  .body { color: var(--ink-2); margin: 0 0 1rem; }

  .split { display: grid; grid-template-columns: 1fr; gap: 3rem; }
  @media (min-width: 900px) { .split { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .start-h { margin: 0.6rem 0 1.2rem; max-width: 22ch; }
  .col-lead { color: var(--ink-3); font-size: 0.95rem; margin: 0.6rem 0 1.6rem; }

  #coaching, #book-diagnosis { scroll-margin-top: 5rem; }
  .coaching-grid, .product-grid { display: grid; gap: 1rem; }
  @media (min-width: 820px) {
    .coaching-grid, .product-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .coaching-card, .product-grid .row { display: flex; flex-direction: column; }
  .coaching-card {
    min-width: 0; padding: clamp(1.25rem, 2.2vw, 2rem);
    background: var(--paper); border: 1px solid var(--line); border-radius: 0.6rem;
  }
  .buyer-quote { margin: 1.25rem 0 0; padding-inline-start: 0.85rem; border-inline-start: 2px solid var(--accent); }
  .buyer-quote blockquote { margin: 0; font-size: 0.94rem; line-height: 1.55; }
  .buyer-quote figcaption { margin-block-start: 0.3rem; font-size: 0.85rem; font-weight: 600; color: var(--ink-2); }
  .coaching-card.featured { border-color: var(--accent); }
  .coaching-card h3, .row h3 {
    font-family: var(--display); font-weight: var(--display-weight);
    font-size: 1.35rem; line-height: 1.2; margin: 0.4rem 0 1rem; color: var(--ink);
  }
  .coaching-card .label, .row .label { color: var(--ink-3); }
  .coaching-card > .btn, .row > .product-action { align-self: flex-start; margin-block-start: auto; white-space: nowrap; }
  .coaching-card > :has(+ .btn), .row > :has(+ .product-action) { margin-block-end: 1.2rem; }
  .price-line { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.45rem; margin: 0; }
  .price { font-family: var(--mono); font-size: clamp(1.3rem, 2.1vw, 1.8rem); font-weight: 500; line-height: 1; font-variant-numeric: tabular-nums; }
  .cur { font-size: 0.85rem; color: var(--ink-3); }

  .price, .cur { white-space: nowrap; }

  .longer-session { margin: 0.2rem 0 0; }
  .buy { display: inline-block; margin-top: 0.9rem; font-size: 0.85rem; font-weight: 600; color: var(--accent-ink); text-decoration: none; border-bottom: 1px solid var(--accent); padding-bottom: 2px; }
  .buy:hover { color: var(--ink); border-color: var(--ink); }
  .row { padding: 1.25rem 0 1rem; border-top: 1px solid var(--line); }
  .vat-note { margin: 1.2rem 0 0; font-size: 0.84rem; color: var(--ink-3); }
  .audience { padding-block: calc(var(--section) * 0.65); }

  .hero-cta { margin-top: 1.65rem; }
  .booking-widget { width: 100%; height: 660px; }
  .booking-link { margin-bottom: 0.75rem; }
  /* stage band */
  .stage { margin: 0; position: relative; background: #0c0c0c; }
  .stage img { width: 100%; height: auto; aspect-ratio: 1400 / 349; object-fit: cover; filter: grayscale(1) contrast(1.05); }
  :global([data-theme="instrument"]) .stage img { filter: grayscale(1) contrast(1.05) brightness(0.72); }
  .stage figcaption { position: absolute; inset-inline: 0; bottom: 0; padding-block: 1.3rem; }
  .stage figcaption::before {
    content: ""; position: absolute; inset: -3.5rem 0 0 0; pointer-events: none;
    background: linear-gradient(to top, rgba(0,0,0,0.85), rgba(0,0,0,0));
  }
  .stage .eyebrow { position: relative; color: color-mix(in srgb, #fff 72%, transparent); }
  .stage p { position: relative; color: #fff; margin-top: 0.45rem; max-width: 58ch; font-size: 0.93rem; line-height: 1.6; }
  @media (max-width: 700px) { .stage img { aspect-ratio: 3 / 2; } .stage p { font-size: 0.84rem; } }

  .pull { margin: 0; max-width: 62ch; }
  .pull p { font-family: var(--display); font-weight: var(--display-weight); font-size: clamp(1.25rem, 2.4vw, 1.75rem); line-height: 1.4; color: var(--ink); margin: 0; }
  .pull cite { display: flex; align-items: center; gap: 0.75rem; margin-top: 1.2rem; font-style: normal; font-size: 0.88rem; color: var(--ink-2); font-weight: 600; }
  .pull cite img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; flex: none; }
  .pull cite .who { display: block; }
  .pull cite span { display: block; color: var(--ink-3); font-weight: 400; }
  .pull.small { margin-bottom: 2.2rem; }
  .pull.small p { font-size: clamp(1.05rem, 1.8vw, 1.25rem); }

  .facts { list-style: none; display: grid; gap: 0.55rem; margin: 1.2rem 0 0; padding: 0; }
  .facts li { position: relative; padding-inline-start: 1.1rem; color: var(--ink-2); font-size: 0.93rem; }
  .facts li::before { content: ""; position: absolute; inset-inline-start: 0; top: 0.78em; width: 8px; height: 1px; background: var(--ink-3); }
</style>
