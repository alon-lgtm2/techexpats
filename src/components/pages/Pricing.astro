---
import Nav from "../Nav.astro";
import Footer from "../Footer.astro";
import CTA from "../CTA.astro";
import Testimonials from "../Testimonials.astro";
import ProofWall from "../ProofWall.astro";
import { type Lang } from "../../i18n";
import { testimonials } from "../../data/testimonials";
interface Props { lang?: Lang }
const { lang = "he" } = Astro.props;

// ---------------------------------------------------------------------------
// BOOKING AND PAYMENT
// Alon creates these in Calendly and Stripe and pastes the URLs here. Nothing
// on this page charges anyone until real URLs replace the placeholders below.
// The scheduler is for the orientation call only; everything else is paid
// first and scheduled afterwards, by mail.
// ---------------------------------------------------------------------------
const LINKS = {
  calendlyOrientation: "https://calendly.com/agildoni/new-meeting", // "שעת ייעוץ", שעה, 190 יורו, נגבה בתוך Calendly
  payOrientation: "",      // לא בשימוש. התשלום על השיחה נגבה בתוך Calendly
  payWorkshop: "https://buy.stripe.com/bJe6oI6J6h1I7RS6UacEw01", // 60
  paySevenADay: "https://buy.stripe.com/00wfZi1oM5j0dcc4M2cEw06", // 360
  payEmployers: "https://buy.stripe.com/eVq00kaZm4eW3BCbaqcEw05", // 35
  payProfile: "https://buy.stripe.com/fZu9AU9VifXE0pqfqGcEw03", // 740, ישיבת עבודה
  // Bank of hours, decided with Alon 2026-10-05. The two hour bank reuses the old 420
  // candidacy link: same price, but the Stripe product still carries the old name, so
  // rename it in Stripe. Five and ten hours have no Stripe link yet; until Alon pastes
  // one here, their buttons open WhatsApp with the purchase pre-written (see buyLink).
  payBank2: "https://buy.stripe.com/9B614o7NacLsb446UacEw02", // 420, 2 שעות
  payBank5: "",  // 950, 5 שעות
  payBank10: "", // 1.740, 10 שעות
  // Retired from the page 2026-10-05, kept for the record: the 1.870 end to end
  // (clients in flight keep their terms) at https://buy.stripe.com/9B69AU0kI8vcegg2DUcEw04
};
// iDEAL is enabled in Stripe payment method settings, not per link. Stripe
// surfaces it first for buyers in the Netherlands, which is most of the book:
// roughly half the invoices are NL-resident, many of them Israelis living here.
const ready = (u: string) => (u && u.length > 0 ? u : "#");
// A bank tier without a Stripe link yet still sells: the button opens WhatsApp with
// the request written, rather than a dead "#".
const buyLink = (key: string, what: string) => {
  const u = (LINKS as Record<string, string>)[key];
  return u && u.length > 0
    ? u
    : "https://wa.me/31644295691?text=" + encodeURIComponent(`היי אלון, אני רוצה לרכוש בנק של ${what}`);
};

// Real reviews, pulled from src/data/testimonials.ts so the page can never
// quote something that is not on the site.
const byName = (n: string) => testimonials.find((t) => t.name === n);
const q = (n: string) => byName(n)?.quote?.he ?? "";
const role = (n: string) => byName(n)?.role ?? "";
const avatar = (n: string) => byName(n)?.avatar ?? "";
const short = (s: string, max = 260) => (s.length > max ? s.slice(0, s.lastIndexOf(" ", max)) + "…" : s);

const PRODUCTS = [
  {
    label: "הסדנה המוקלטת",
    title: "לראות איך נראה חיפוש עבודה שעובד.",
    price: "60",
    pay: "payWorkshop",
    items: [
      "ערב מלא, 85 דקות, עם קהל אמיתי ששואל וגם חולק עליי",
      "פרומפט בשידור חי: מתרגמים פרופיל אמיתי לטייטלים ולתעשיות הולנדיות",
      "מי באמת פתח את המשרה, ואיך פונים אליו בלי להישרף",
      "כולל הפרומפטים, רשימת ההדהאנטרים ותבנית קורות חיים",
    ],
  },
  {
    label: "מאגר המעסיקים הישראליים",
    title: "ספר טלפונים של החברות הישראליות בהולנד.",
    price: "35",
    pay: "payEmployers",
    items: [
      "רק חברות עם פעילות ממשית בהולנד, לא סניף על הנייר. לכל אחת הערים, הכתובות, סוגי התפקידים וקישור לעמוד הקריירה",
      "גישה עם סיסמה למאגר החי. אני מתחזק אותו, חברות נכנסות ויוצאות, ואתם רואים תמיד את המצב המעודכן",
      "נקודת התחלה לחיפוש עצמאי. זה מאגר, לא כיוון: הוא לא יודע מי אתם ולאן כדאי לכם לכוון",
    ],
  },
  {
    label: "שבע ביום",
    title: "האפליקציה שמריצה את החיפוש.",
    price: "360",
    pay: "paySevenADay",
    items: [
      "חיפוש עבודה שנעשה נכון הוא משמעת, לא הגרלה. שבע פעולות ממוקדות ביום, עם רצפים ותנופה",
      "מאגר חברות: דירוג, הפעולה הבאה, ותיעוד כל אינטראקציה",
      "“פריזר” להקפאת חברות לכמה ימים, ו“מגרש חניה” ללידים",
      "מאגר החברות הישראליות בהולנד כלול, וגם הסדנה המוקלטת",
      "שלושה חודשים, ואחר כך 29 יורו לחודש. אפשר להפסיק בכל חודש",
    ],
  },
];

// The ladder, decided with Alon on 2026-10-05 (methodology/pricing-rethink_2026-09-29_DRAFT.md,
// items 10 to 15): the hour is the first step and says so; the working session is sold on
// value, its deliverables are made in the room, and one consultation hour follows it;
// everything after that is hours from a bank. The 420 candidacy preparation became the
// two hour bank, and the 1.870 end to end left the page.
const SERVICES = [
  {
    label: "שעת ייעוץ",
    title: "הצעד הראשון.",
    price: "190",
    pay: "payOrientation",
    entry: true,
    items: [
      "שעה מלאה על המצב שלכם: איפה אתם עומדים, מה באמת עוצר אתכם, ומה הצעד הנכון הבא",
      "זו שיחת פתיחה, לא תוכנית. בסופה תדעו אם ואיך אני יכול לעזור, ומה זה יעלה",
      "סיכום כתוב קצר, עם ההמלצה שלי",
    ],
  },
  {
    label: "ישיבת עבודה",
    title: "יושבים יחד, ויוצאים עם כל מה שצריך.",
    price: "740",
    pay: "payProfile",
    entry: false,
    items: [
      "ישיבה ארוכה אחת, אחד על אחד, שבה בונים יחד את הבסיס לחיפוש נכון",
      "הפרופיל המקצועי שלכם, לאן מכוונים, אל מי פונים בכל מקום, ומה המשפט שאיתו פותחים",
      "הנחיות מדויקות לשיפור קורות החיים והלינקדאין",
      "התוצרים נבנים בישיבה עצמה, ואתם יוצאים איתם ביד",
      "ואחריה, שעת ייעוץ נוספת כלולה במחיר",
      "שבע ביום כלול, לשלושה חודשים",
      "המטרה היא לא למצוא עבודה. היא למצוא את העבודה: האופטימלית עבורכם, במקום שתשמחו להיות בו, אצל מעסיק שרק חיכה שתגיעו",
    ],
  },
  {
    label: "בנק שעות",
    title: "מה שצריך, מתי שצריך.",
    price: "420",
    from: true,
    pay: "payBank2",
    entry: false,
    tiers: [
      { hours: "2 שעות", price: "420", pay: "payBank2" },
      { hours: "5 שעות", price: "950", pay: "payBank5" },
      { hours: "10 שעות", price: "1.740", pay: "payBank10" },
    ],
    items: [
      "סימולציה של ראיון, עם תחקיר והקלטה, היא שעתיים",
      "שאלות, מעבר על מחקר, קורות חיים ולינקדאין, הכנה לשיחת שכר, וכל מה שעולה בדרך",
      "יורד בחצאי שעות, לפי הזמן בפועל. בכל סיכום כתוב כמה נשאר",
      "תקף לחצי שנה מיום הרכישה",
      "מי שהתחיל בשעת ייעוץ ועשה ישיבת עבודה מקבל שעה נוספת בבנק הראשון",
    ],
  },
];
---

<Nav lang={lang} />

<section class="hero section">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">מה זה עולה</span>
      <h1 class="display-xl">מוצרים, <em>וייעוץ.</em></h1>
      <p class="lead">מוצר הוא דבר שאתם קונים ומשתמשים בו לבד, בקצב שלכם. ייעוץ הוא הזמן שלי, אתכם. כל מחיר כאן גלוי, ולצידו כתוב בדיוק מה מקבלים.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={ready(LINKS.calendlyOrientation || LINKS.payOrientation)}>לקביעת שעת ייעוץ · 190 יורו</a>
        <p class="hero-cta-note">הצעד הראשון: שעה על המצב שלכם, ובסופה המלצה ברורה מה הלאה. מי שכבר יודע מה הוא רוצה יכול לקנות ישירות.</p>
      </div>
    </div>
    <figure class="hero-portrait">
      <img src="/alon-portrait.jpg" alt="אלון גילדוני" width="900" height="1125" />
      <figcaption>אלון גילדוני<span>הזמן שאתם קונים כאן הוא שלי</span></figcaption>
    </figure>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <div class="split">

      <div class="col">
        <span class="eyebrow">מוצרים</span>
        <p class="col-lead">קונים פעם אחת ומשתמשים לבד. בלי פגישות, בלי תיאום יומן, ובלי לדבר איתי קודם.</p>
        <div class="rows">
          {PRODUCTS.map((p) => (
            <article class="row">
              <span class="label">{p.label}</span>
              <div class="rhead">
                <h3>{p.title}</h3>
                <p class="price-line"><span class="price">{p.price}</span><span class="cur">יורו</span></p>
              </div>
              <ul class="items">{p.items.map((i) => <li>{i}</li>)}</ul>
              <a class="buy" href={ready(LINKS[p.pay as keyof typeof LINKS])}>לרכישה</a>
            </article>
          ))}
        </div>
      </div>

      <div class="col">
        <span class="eyebrow">ייעוץ</span>
        <p class="col-lead">הזמן שלי, אתכם, בשלושה שלבים. <strong>מתחילים בשעת ייעוץ.</strong> ממשיכים לישיבת עבודה, שבה בונים יחד את כל מה שצריך. ומשם, כל מה שעוד צריך הוא שעות מהבנק, לפי הצורך.</p>
        <div class="rows">
          {SERVICES.map((p) => (
            <article class={p.entry ? "row entry" : "row"}>
              <span class="label">{p.label}</span>
              <div class="rhead">
                <h3>{p.title}</h3>
                <p class="price-line">{p.from && <span class="cur">החל מ־</span>}<span class="price">{p.price}</span><span class="cur">יורו</span></p>
              </div>
              <ul class="items">{p.items.map((i) => <li>{i}</li>)}</ul>
              {p.tiers
                ? <ul class="tiers">{p.tiers.map((t) => (
                    <li>
                      <span class="t-h">{t.hours}</span>
                      <span class="t-p"><span class="price t-price">{t.price}</span><span class="cur">יורו</span></span>
                      <a class="buy" href={buyLink(t.pay, t.hours)}>לרכישה</a>
                    </li>
                  ))}</ul>
                : p.entry
                  ? <a class="buy" href={ready(LINKS.calendlyOrientation)}>לקביעת שיחה</a>
                  : <a class="buy" href={ready(LINKS[p.pay as keyof typeof LINKS])}>לרכישה ישירה</a>}
            </article>
          ))}
        </div>
        <a class="btn btn-primary svc-cta" href={ready(LINKS.calendlyOrientation)}>לקביעת שעת ייעוץ · 190 יורו</a>
        <p class="why">אין שיחת היכרות חינם. שיחה חינמית היא לא באמת חינם: אני נותן בה את הדבר הכי טוב שיש לי, ואתם יוצאים ממנה עם עצה שאין לכם מה לעשות איתה. עדיף לגבות מעט, ולתת לכם משהו כתוב שאפשר לעשות איתו משהו.</p>
      </div>

    </div>
    <p class="vat-note"><strong>המחירים אינם כוללים מע"מ.</strong> מע"מ הולנדי בשיעור 21% מתווסף ללקוחות באיחוד האירופי, ומופיע בעמוד התשלום או בחשבונית. <strong>לתושבי ישראל ולמי שגר מחוץ לאיחוד האירופי לא מתווסף מע"מ</strong>, והמחיר הוא זה שמופיע כאן.</p>
  </div>
</section>

<!-- STAGE BAND.
     Added 2026-09-04 at Alon's request. NOTE FOR ANYONE EDITING: this is the
     SAME photograph as the homepage band and the About page, at a tighter
     1400x349 crop rather than 1600x554. It is carried as its own asset because
     the letterbox reads differently, but it is one shot doing three jobs. The
     caption is deliberately unlike the homepage one so the repeat is not
     obvious. Replace it the moment a second usable working photo exists;
     public/README.md lists what to shoot. -->
<figure class="stage">
  <img src="/alon-stage-wide.jpg" alt="אלון גילדוני מרצה מול קהל" width="1400" height="349" loading="lazy" />
  <figcaption class="container">
    <span class="eyebrow">בערבים כאלה</span>
    <p>החלק החינמי של מה שאני עושה קורה על במות כאלה, והוא נשאר חינמי. מה שבעמוד הזה הוא הגרסה האחת על אחת, על המצב הספציפי שלכם, ובסופה משהו כתוב.</p>
  </figcaption>
</figure>

<!-- REVIEW -->
<section class="section quote-sec">
  <div class="container">
    <blockquote class="pull">
      <p>{short(q("Eva Bishara Khoury"), 300)}</p>
      <cite><img src={avatar("Eva Bishara Khoury")} alt="" loading="lazy" /><span class="who">אווה בישארה חורי<span>{role("Eva Bishara Khoury")}</span></span></cite>
    </blockquote>
  </div>
</section>

<!-- SCHEDULER -->
<section class="section alt">
  <div class="container">
    <div class="split">
      <div class="col">
        <span class="eyebrow">לקבוע</span>
        <h2 class="display-md">שעת ייעוץ, 190 יורו.</h2>
        <p class="body">בוחרים מועד, משלמים, ומקבלים אישור. בסוף השעה תדעו מה הצעד הבא, ואם הוא איתי, כמה הוא עולה.</p>
        {LINKS.calendlyOrientation
          ? <div class="calendly-inline-widget" data-url={LINKS.calendlyOrientation} style="min-width:320px;height:660px;"></div>
          : <p class="placeholder">כאן ייכנס לוח הזמנים. צריך אירוע חדש ב-Calendly לשיחה בתשלום, והכתובת שלו נכנסת לראש הקובץ.</p>}
      </div>
      <div class="col">
        <blockquote class="pull small">
          <p>{short(q("Reshef Katz"), 220)}</p>
          <cite><img src={avatar("Reshef Katz")} alt="" loading="lazy" /><span class="who">רשף כץ<span>{role("Reshef Katz")}</span></span></cite>
        </blockquote>
        <blockquote class="pull small">
          <p>{short(q("Yair Sepunaru"), 220)}</p>
          <cite><img src={avatar("Yair Sepunaru")} alt="" loading="lazy" /><span class="who">יאיר ספונארו<span>{role("Yair Sepunaru")}</span></span></cite>
        </blockquote>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="split">
      <div class="col">
        <span class="eyebrow">על ההבטחה</span>
        <div class="stats">
          <div><span class="fig">70%</span><span class="cap">מוצאים עבודה תוך 3 חודשים</span></div>
          <div><span class="fig">~85%</span><span class="cap">תוך 6 חודשים</span></div>
        </div>
        <p class="body">המספרים טובים, אבל אין כל הבטחה או התחייבות למציאת עבודה. יש פה גם ביקוש, תעשייה ומזל.</p>
        <p class="body"><strong>בקבלה בלבד.</strong> אני עובד עם מספר קטן של אנשים עם ניסיון משמעותי, כדי לתת לכל אחד תשומת לב אמיתית. וזה גם לא מתאים לכולם: אם אתם מחפשים שמישהו “יחבר” אתכם לעבודה, או שמצב הוויזה דחוף ואין זמן לתהליך מסודר, אני אגיד לכם את זה בשיחה.</p>
      </div>
      <div class="col">
        <span class="eyebrow">דברים מעשיים</span>
        <ul class="facts">
          <li><strong>iDEAL היא דרך התשלום המומלצת.</strong> מהירה, ישירה מחשבון הבנק, ובלי להזין פרטי כרטיס</li>
          <li>אפשר גם בכרטיס אשראי, ובשקלים לפי שער ההמרה ביום התשלום</li>
          <li>אפשר לפצל לשני תשלומים</li>
          <li>הוואטסאפ משמש לתיאום מועדים. שאלות שצריכות תשובה נענות מתוך בנק השעות</li>
          <li>המע"מ, אם הוא חל עליכם, מחושב ומוצג בעמוד התשלום לפני שאתם מאשרים</li>
          <li>התשלום מאובטח דרך Stripe. אין לי גישה לפרטי האמצעי שלכם</li>
        </ul>
      </div>
    </div>
  </div>
</section>

{LINKS.calendlyOrientation && <script is:inline async src="https://assets.calendly.com/assets/external/widget.js"></script>}

<Testimonials lang={lang} limit={9} source="coaching" heading="מי שכבר עשה את זה." sub="שלוש עשרה ביקורות, כולן מהצד של הליווי, וכולן של אנשים אמיתיים. מי שביקש להישאר אנונימי מופיע בראשי תיבות." />

<ProofWall lang={lang} />

<CTA lang={lang} />
<Footer lang={lang} />

<style>
  .alt { background: var(--paper-2); }
  .hero { padding-block: calc(var(--section) * 0.62) calc(var(--section) * 0.4); }
  .hero-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center; }
  /* The page carried no photograph at all, and the hero was one narrow column
     of text with the other half of the width empty (Alon, 2026-09-04). */
  .hero-portrait { margin: 0; position: relative; max-width: 22rem; }
  /* height: auto is load-bearing. The width/height attributes stay on the tag
     so the browser reserves the space and the page does not jump, but an HTML
     height attribute is a used value and it silently beats aspect-ratio, which
     is why the portrait first rendered 352 wide by its full 1125 tall. */
  .hero-portrait img { width: 100%; height: auto; aspect-ratio: 4/5; object-fit: cover; object-position: center top; filter: grayscale(1) contrast(1.04); }
  .hero-portrait figcaption {
    position: absolute; bottom: 0; inset-inline-start: 0; background: var(--accent); color: var(--on-accent);
    font-size: 0.78rem; font-weight: 600; padding: 0.5rem 0.9rem; line-height: 1.3;
  }
  .hero-portrait figcaption span { display: block; font-weight: 400; opacity: 0.85; font-size: 0.72rem; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.45fr 0.8fr; gap: 3.5rem; } }
  /* Hebrew has no italic. The browser was synthesising an oblique on Heebo,
     which is what made "וייעוץ." look wrong in the screenshot Alon sent.
     Colour carries the emphasis instead. */
  .hero h1 em { font-style: normal; color: var(--accent); }
  .hero .lead { max-width: 60ch; margin-top: 1.4rem; }
  .body { color: var(--ink-2); margin: 0 0 1rem; }

