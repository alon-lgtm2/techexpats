---
import Nav from "../Nav.astro";
import Footer from "../Footer.astro";
import CTA from "../CTA.astro";
import { getT, localizePath, type Lang } from "../../i18n";
interface Props { lang?: Lang }
const { lang = "en" } = Astro.props;
const t = getT(lang);
const a = t.aboutPage;

const facts = [a.fact1, a.fact2, a.fact3, a.fact4];
const blocks = [
  { h: a.introHeading, p: [a.intro1, a.intro2] },
  { h: a.bothHeading, p: [a.both1, a.both2] },
  { h: a.europeHeading, p: [a.europe1, a.europe2] },
  { h: a.howHeading, p: [a.how1] },
];
---

<Nav lang={lang} />

<section class="hero section">
  <div class="container grid">
    <div>
      <span class="eyebrow">{a.eyebrow}</span>
      <h1 class="display-xl">{a.name}</h1>
      <p class="role label">{a.role}</p>
      <p class="lead">{a.tagline}</p>
      <div class="ctas">
        <a href={localizePath("/contact", lang)} class="btn btn-primary">{a.ctaPrimary} <span class="arrow">&rarr;</span></a>
        <a href={localizePath("/career-advice", lang)} class="btn btn-ghost">{a.ctaInsights}</a>
      </div>
    </div>
    <div class="portrait">
      <img src="/alon.jpg" alt={a.photoAlt} />
      <span class="portrait-tag">ALON GILDONI / FOUNDER</span>
    </div>
  </div>
</section>

<section class="facts">
  <div class="container facts-grid">
    {facts.map((f, i) => (
      <div class="fact">
        <span class="fact-n label">{String(i + 1).padStart(2, "0")}</span>
        <p>{f}</p>
      </div>
    ))}
  </div>
</section>

<section class="section">
  <div class="container blocks">
    {blocks.map((b, i) => (
      <article class="block">
        <span class="block-n label">{String(i + 1).padStart(2, "0")} /</span>
        <div>
          <h2 class="display-md">{b.h}</h2>
          {b.p.map((para) => <p>{para}</p>)}
        </div>
      </article>
    ))}
  </div>
</section>

<CTA lang={lang} heading={a.closeHeading} body={a.close1} />
<Footer lang={lang} />

<style>
  .hero { padding-top: clamp(2.5rem, 5vw, 4rem); }
  .grid { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
  .role { display: block; margin: 1.2rem 0 1.2rem; color: var(--accent); }
  .lead { max-width: 34ch; }
  .ctas { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 2rem; }
  .portrait { position: relative; }
  .portrait img { width: 100%; aspect-ratio: 4/5; object-fit: cover; object-position: center top; filter: grayscale(1) contrast(1.04); border-radius: var(--radius); }
  .portrait-tag { position: absolute; bottom: 0; inset-inline-start: 0; background: var(--accent); color: #fff; font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.12em; padding: 0.45rem 0.85rem; }
  @media (min-width: 860px) { .grid { grid-template-columns: 1.3fr 0.85fr; gap: 4rem; } }

  .facts { background: var(--ink); color: var(--paper); }
  .facts-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; padding-block: 2.5rem; }
  .fact { display: flex; gap: 0.85rem; align-items: flex-start; }
  .fact-n { color: var(--accent); flex-shrink: 0; }
  .fact p { font-size: 0.92rem; color: color-mix(in srgb, var(--paper) 80%, transparent); }
  @media (min-width: 760px) { .facts-grid { grid-template-columns: repeat(4, 1fr); gap: 2rem; } }

  .blocks { display: flex; flex-direction: column; gap: 3.5rem; max-width: 64rem; }
  .block { display: grid; grid-template-columns: 1fr; gap: 1rem; border-top: 2px solid var(--ink); padding-top: 1.5rem; }
  .block-n { color: var(--accent); font-size: 0.9rem; }
  .block h2 { margin-bottom: 1rem; }
  .block p { color: var(--ink-2); max-width: 60ch; }
  .block p + p { margin-top: 1rem; }
  @media (min-width: 760px) { .block { grid-template-columns: 6rem 1fr; gap: 2rem; } }
</style>
