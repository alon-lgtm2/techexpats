---
import Nav from "../Nav.astro";
import Footer from "../Footer.astro";
import CTA from "../CTA.astro";
import Testimonials from "../Testimonials.astro";
import { localizePath, type Lang } from "../../i18n";
interface Props { lang?: Lang }
const { lang = "en" } = Astro.props;

const COPY = {
  en: {
    eyebrow: "About",
    name: "Alon Gildoni",
    role: "Hiring leader, headhunter, and career coach",
    tagline: "Twenty years on the hiring side of the table. Now in your corner.",
    photoAlt: "Alon Gildoni speaking to an audience",
    facts: ["~20 years hiring", "Harvard Business School", "Amsterdam · Europe", "EN · NL · HE"],
    blocks: [
      {
        h: "On both sides of the table",
        p: [
          "For nearly two decades I built and led product and technology organizations, which means I spent nearly two decades hiring: sitting on the side of the table that decides. I read the CVs, ran the interviews, made the offers, and lived with the results. Today I bring that experience to the other side, as an advisor to the people and companies navigating it.",
          "I am not a consultant who studied hiring from the outside. I am an operator who did it, at scale, for years. That is the difference between advice that sounds right and advice that works.",
        ],
      },
      {
        h: "Why that matters to you",
        p: [
          "When I coach you, you get the view from inside the room: what actually gets a CV read, why strong people get passed over, what a hiring manager is really worried about, and how to position yourself so the answer is yes.",
          "When I run a search for your company, you get someone who has sat in your seat and can have the honest conversation that turns a strong, passive candidate into your next hire.",
        ],
      },
      {
        h: "Built on community",
        p: [
          "Driven by a commitment to the community around me, I founded the Israeli tech community in the Netherlands, which has grown into one of Europe's most connected professional networks. I stay closely involved in it, and I mentor founders and professionals building careers across the continent.",
          "Alongside that I run a practice advising leaders on decision quality and on embedding AI into the way an organisation actually works: hands-on sprints with individual executives and their teams, in English, on their own live material. Not a tools rollout, and not a lecture. A working method that outlives the next model release.",
          "I also take on a small number of unusual projects outside careers, by referral only.",
        ],
      },
      {
        h: "Background",
        p: [
          "I am an alumnus of Harvard Business School. I am based in Amsterdam and work across the Netherlands and Europe, in English, Dutch, and Hebrew, and I am always glad to connect with people who want to make meaningful impact.",
        ],
      },
    ],
    closeHeading: "Let's talk.",
    closeBody: "Whether you are planning your next move or your next hire, start with a paid consultation. It ends in something written, and there is no pitch.",
    ctaPrimary: "Start a conversation",
    ctaInsights: "Read my writing",
  },
  he: {
    eyebrow: "אודות",
    name: "אלון גילדוני",
    role: "מנהל גיוס, צייד ראשים ומאמן קריירה",
    tagline: "עשרים שנה בצד המגייס של השולחן. עכשיו, לצידכם.",
    photoAlt: "אלון גילדוני נואם מול קהל",
    facts: ["כ-20 שנות גיוס", "Harvard Business School", "אמסטרדם · אירופה", "EN · NL · HE"],
    blocks: [
      {
        h: "משני צידי השולחן",
        p: [
          "במשך קרוב לשני עשורים בניתי והובלתי ארגוני מוצר וטכנולוגיה, ומשמעות הדבר היא שכמעט שני עשורים גייסתי: ישבתי בצד של מי שמחליט. קראתי את קורות החיים, ניהלתי את הראיונות, נתתי את ההצעות וחייתי עם התוצאות. היום אני מביא את הניסיון הזה לצד השני, כיועץ לאנשים ולחברות שמתמודדים עם זה.",
          "אינני יועץ שלמד גיוס מבחוץ. אני איש מקצוע שעשה את זה, בקנה מידה, במשך שנים. זה ההבדל בין עצה שנשמעת נכון לעצה שעובדת.",
        ],
      },
      {
        h: "למה זה חשוב לכם",
        p: [
          "כשאני מלווה אתכם, אתם מקבלים את המבט מתוך החדר: מה באמת גורם לקורות חיים להיקרא, למה אנשים מצוינים נדחים, ממה מנהל הגיוס באמת חושש, ואיך למצב את עצמכם כך שהתשובה תהיה כן.",
          "כשאני מנהל חיפוש עבור החברה שלכם, אתם מקבלים מישהו שישב בכיסא שלכם ויודע לנהל את השיחה הכנה שהופכת מועמד פסיבי וחזק לגיוס הבא שלכם.",
        ],
      },
      {
        h: "נבנה על קהילה",
        p: [
          "מתוך מחויבות עמוקה לקהילה שסביבי הקמתי את קהילת ההייטק הישראלית בהולנד, שצמחה לאחת הרשתות המקצועיות המחוברות באירופה. אני ממשיך להיות מעורב בה מקרוב, ומלווה יזמים ואנשי מקצוע שבונים קריירה ברחבי היבשת.",
          "לצד זה אני מנהל פרקטיקה שמייעצת למנהלים על איכות קבלת החלטות ועל הטמעת בינה מלאכותית בדרך שבה ארגון באמת עובד: ספרינטים מעשיים עם מנהלים ועם הצוותים שלהם, באנגלית, על החומר החי שלהם. לא הטמעת כלים ולא הרצאה. שיטת עבודה ששורדת את הגרסה הבאה של המודל.",
          "אני גם לוקח מספר קטן של פרויקטים חריגים מחוץ לעולם הקריירה, בהפניה בלבד.",
        ],
      },
      {
        h: "רקע",
        p: [
          "אני בוגר Harvard Business School. אני גר באמסטרדם ופועל ברחבי הולנד ואירופה, באנגלית, הולנדית ועברית, ותמיד שמח להכיר אנשים שרוצים לייצר השפעה משמעותית.",
        ],
      },
    ],
    closeHeading: "בואו נדבר.",
    closeBody: "בין אם אתם מתכננים את הצעד הבא שלכם או את הגיוס הבא, מתחילים בשיחת ייעוץ בתשלום. היא נגמרת במשהו כתוב, ובלי מכירה.",
    ctaPrimary: "פתחו בשיחה",
    ctaInsights: "לקריאת המאמרים",
  },
};

const c = COPY[lang as "en" | "he"] ?? COPY.en;
---

<Nav lang={lang} />

<section class="hero section">
  <div class="container grid">
    <div class="copy">
      <span class="eyebrow">{c.eyebrow}</span>
      <h1 class="display-xl">{c.name}</h1>
      <p class="role label">{c.role}</p>
      <p class="lead">{c.tagline}</p>
      <div class="ctas">
        <a href={localizePath("/contact", lang)} class="btn btn-primary">{c.ctaPrimary} <span class="arrow">&rarr;</span></a>
        <a href={localizePath("/career-advice", lang)} class="btn btn-ghost">{c.ctaInsights}</a>
      </div>
    </div>
    <figure class="portrait">
      <img src="/alon-speaking.jpg" alt={c.photoAlt} />
    </figure>
  </div>
</section>

<section class="facts">
  <div class="container facts-grid">
    {c.facts.map((f, i) => (
      <div class="fact">
        <span class="fact-n label">{String(i + 1).padStart(2, "0")}</span>
        <span class="fact-t">{f}</span>
      </div>
    ))}
  </div>
</section>

<section class="section">
  <div class="container blocks">
    {c.blocks.map((b, i) => (
      <article class="block">
        <span class="block-n label">{String(i + 1).padStart(2, "0")} /</span>
        <div class="block-body">
          <h2 class="display-md">{b.h}</h2>
          {b.p.map((para) => <p>{para}</p>)}
        </div>
      </article>
    ))}
  </div>
</section>

<!-- The page that answers "who is this person" carried no review at all
     until 2026-09-05. Nine of them, directly before the closing CTA. -->
<Testimonials lang={lang} limit={9} source="coaching" />

<CTA lang={lang} heading={c.closeHeading} body={c.closeBody} />
<Footer lang={lang} />

<style>
  .hero { padding-top: clamp(2.5rem, 5vw, 4rem); }
  .grid { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
  .role { display: block; margin: 1.2rem 0; color: var(--accent); }
  .lead { max-width: 32ch; }
  .ctas { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 2rem; }
  .portrait { margin: 0; position: relative; }
  .portrait img { width: 100%; aspect-ratio: 3/2; object-fit: cover; filter: grayscale(1) contrast(1.04); border-radius: var(--radius); }
  @media (min-width: 860px) { .grid { grid-template-columns: 1fr 1.1fr; gap: 4rem; } .portrait img { aspect-ratio: 4/3; } }

  .facts { background: var(--ink); color: var(--paper); }
  .facts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem 1.5rem; padding-block: 2.5rem; }
  .fact { display: flex; flex-direction: column; gap: 0.3rem; }
  .fact-n { color: var(--accent); }
  .fact-t { font-family: var(--display); font-weight: var(--display-weight); font-size: 1.05rem; color: var(--paper); }
  @media (min-width: 760px) { .facts-grid { grid-template-columns: repeat(4, 1fr); gap: 2rem; } }

  .blocks { display: flex; flex-direction: column; gap: 3rem; max-width: 66rem; }
  .block { display: grid; grid-template-columns: 1fr; gap: 1rem; border-top: 2px solid var(--ink); padding-top: 1.5rem; }
  .block-n { color: var(--accent); font-size: 0.9rem; }
  .block-body h2 { margin-bottom: 1rem; }
  .block-body p { color: var(--ink-2); max-width: 64ch; }
  .block-body p + p { margin-top: 1rem; }
  @media (min-width: 760px) { .block { grid-template-columns: 7rem 1fr; gap: 2rem; } }
</style>
