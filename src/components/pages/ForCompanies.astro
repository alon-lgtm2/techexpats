---
import Nav from "../Nav.astro";
import Footer from "../Footer.astro";
import CTA from "../CTA.astro";
import { getT, localizePath, type Lang } from "../../i18n";
interface Props { lang?: Lang }
const { lang = "en" } = Astro.props;
const t = getT(lang);
const f = t.forCompanies;

const steps = [
  { n: "01", t: f.s1t, d: f.s1d },
  { n: "02", t: f.s2t, d: f.s2d },
  { n: "03", t: f.s3t, d: f.s3d },
];
const searchItems = [f.a1, f.a2, f.a3, f.a4];
const sprint = [f.b1, f.b2, f.b3, f.b4, f.b5];
const trust = [
  { l: f.t1Label, b: f.t1Body },
  { l: f.t2Label, b: f.t2Body },
  { l: f.t3Label, b: f.t3Body },
  { l: f.t4Label, b: f.t4Body },
];
---

<Nav lang={lang} />

<section class="hero section">
  <div class="container">
    <span class="eyebrow">{f.eyebrow}</span>
    <h1 class="display-xl">{f.h1}<br /><span class="accent">{f.h2}</span></h1>
    <p class="lead">{f.sub}</p>
    <div class="ctas">
      <a href={localizePath("/contact", lang)} class="btn btn-primary">{f.ctaPrimary} <span class="arrow">&rarr;</span></a>
      <a href={localizePath("/book", lang)} class="btn btn-ghost">{f.ctaSecondary}</a>
    </div>
    <p class="signature mono">{f.signature}</p>
  </div>
</section>

<section class="section problem-sec">
  <div class="container">
    <h2 class="display-md p-head">{f.problemHeading}</h2>
    <p class="p-body">{f.problemBody}</p>
  </div>
</section>

<!-- ===== THE TWO OFFERS ===== -->
<section class="section">
  <div class="container">
    <span class="eyebrow">{f.offersEyebrow}</span>
    <h2 class="display-lg sec-h">{f.offersHeading}</h2>

    <article class="offer">
      <span class="offer-tag mono">{f.aTag}</span>
      <h3 class="display-lg offer-h">{f.aHeading}</h3>
      <div class="offer-grid">
        <div class="offer-body">
          <div class="field">
            <span class="label k">{f.aWhoLabel}</span>
            <p>{f.aWho}</p>
          </div>
          <div class="field">
            <span class="label k">{f.aProblemLabel}</span>
            <p>{f.aProblem}</p>
          </div>
          <div class="field">
            <span class="label k">{f.aWorkLabel}</span>
            <p>{f.aWork}</p>
          </div>
        </div>
        <div class="offer-side">
          <ul class="check">{searchItems.map((w) => <li>{w}</li>)}</ul>
          <div class="terms">
            <span class="label k">{f.aTermsLabel}</span>
            <p>{f.aTerms}</p>
          </div>
        </div>
      </div>
    </article>

    <article class="offer">
      <span class="offer-tag mono">{f.bTag}</span>
      <h3 class="display-lg offer-h">{f.bHeading}</h3>
      <div class="offer-grid">
        <div class="offer-body">
          <div class="field">
            <span class="label k">{f.bWhoLabel}</span>
            <p>{f.bWho}</p>
          </div>
          <div class="field">
            <span class="label k">{f.bProblemLabel}</span>
            <p>{f.bProblem}</p>
          </div>
          <div class="field">
            <span class="label k">{f.bWorkLabel}</span>
            <p>{f.bWork}</p>
          </div>
        </div>
        <div class="offer-side">
          <ol class="sprint">
            {sprint.map((s, i) => (
              <li><span class="sprint-n mono">{String(i + 1).padStart(2, "0")}</span>{s}</li>
            ))}
          </ol>
          <div class="terms">
            <span class="label k">{f.bProofLabel}</span>
            <p>{f.bProof}</p>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<!-- ===== WHO YOU ARE CONTRACTING WITH ===== -->
<section class="section trust-sec">
  <div class="container">
    <div class="trust-head">
      <div>
        <span class="eyebrow">{f.trustEyebrow}</span>
        <h2 class="display-lg sec-h">{f.trustHeading}</h2>
      </div>
      <p class="kvk mono">KvK 42085435</p>
    </div>
    <div class="trust-grid">
      {trust.map((t, i) => (
        <article class="trust-item">
          <span class="trust-n mono">{String(i + 1).padStart(2, "0")}</span>
          <span class="trust-l">{t.l}</span>
          <p>{t.b}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ===== HOW A SEARCH RUNS ===== -->
<section class="section alt">
  <div class="container">
    <span class="eyebrow">{f.processEyebrow}</span>
    <h2 class="display-lg sec-h">{f.processHeading}</h2>
    <div class="steps">
      {steps.map((s) => (
        <article class="step">
          <span class="step-n">{s.n}</span>
          <h3 class="display-md">{s.t}</h3>
          <p>{s.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ===== WHY ME ===== -->
<section class="section">
  <div class="container two">
    <div>
      <span class="eyebrow">{f.proofEyebrow}</span>
      <h2 class="display-lg sec-h">{f.proofHeading}</h2>
      <p class="proof-body">{f.proofBody}</p>
      <p class="proof-honest">{f.proofHonest}</p>
    </div>
    <div class="why">
      <span class="eyebrow">{f.whyEyebrow}</span>
      <h3 class="display-md">{f.whyHeading}</h3>
      <p>{f.whyBody}</p>
      <p class="closing">{f.closing}</p>
    </div>
  </div>
</section>

<CTA lang={lang} heading={f.ctaHeading} body={f.ctaBody} />
<Footer lang={lang} />

<style>
  .hero .display-xl .accent { color: var(--accent); }
  .hero .lead { max-width: 58ch; margin: 1.5rem 0 2rem; }
  .ctas { display: flex; gap: 0.9rem; flex-wrap: wrap; }
  .signature { margin-top: 2rem; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); }
  .signature::before { content: "// "; color: var(--accent); }
  .alt { background: var(--paper-2); }
  .sec-h { margin: 1.1rem 0 2.5rem; max-width: 22ch; }
  .k { color: var(--accent); }

  .problem-sec { background: var(--ink); color: var(--paper); }
  .p-head { color: var(--paper); max-width: 22ch; }
  .p-body { color: color-mix(in srgb, var(--paper) 80%, transparent); max-width: 62ch; margin-top: 1.2rem; font-size: 1.05rem; line-height: 1.65; }

  /* the two offers */
  .offer { border-top: 2px solid var(--ink); padding-top: 1.5rem; margin-bottom: 4rem; }
  .offer:last-child { margin-bottom: 0; }
  .offer-tag { display: block; font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); }
  .offer-h { margin: 0.8rem 0 2rem; max-width: 20ch; }
  .offer-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; }
  .field { margin-bottom: 1.6rem; }
  .field:last-child { margin-bottom: 0; }
  .field .label { display: block; margin-bottom: 0.5rem; }
  .field p { color: var(--ink-2); max-width: 58ch; line-height: 1.7; }

  .check { list-style: none; display: flex; flex-direction: column; gap: 0.8rem; }
  .check li { position: relative; padding-inline-start: 1.6rem; color: var(--ink-2); font-size: 0.95rem; }
  .check li::before { content: "+"; position: absolute; inset-inline-start: 0; color: var(--accent); font-family: var(--mono); }

  .sprint { list-style: none; display: flex; flex-direction: column; gap: 0.85rem; }
  .sprint li { display: flex; gap: 0.7rem; color: var(--ink-2); font-size: 0.95rem; align-items: baseline; }
  .sprint-n { color: var(--accent); font-size: 0.75rem; flex: none; }

  .terms { margin-top: 2rem; border-inline-start: 3px solid var(--line); padding-inline-start: 1.2rem; }
  .terms .label { display: block; margin-bottom: 0.5rem; }
  .terms p { color: var(--ink-3); font-size: 0.9rem; line-height: 1.65; }

  /* who you are contracting with */
  .trust-sec { background: var(--ink); color: var(--paper); }
  .trust-sec .eyebrow { color: color-mix(in srgb, var(--paper) 65%, transparent); }
  .trust-sec .sec-h { color: var(--paper); margin-bottom: 0; }
  .trust-head { display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: space-between; align-items: flex-end; }
  .kvk {
    font-size: 0.9rem; letter-spacing: 0.16em; color: var(--paper);
    border: 1px solid color-mix(in srgb, var(--paper) 40%, transparent);
    padding: 0.55rem 1rem;
  }
  .trust-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; margin-top: 3rem; }
  .trust-item { border-top: 1px solid color-mix(in srgb, var(--paper) 30%, transparent); padding-top: 1.1rem; }
  .trust-n { display: block; color: var(--accent); font-size: 0.75rem; letter-spacing: 0.14em; margin-bottom: 0.6rem; }
  .trust-l { display: block; color: var(--paper); font-weight: 600; margin-bottom: 0.6rem; }
  .trust-item p { color: color-mix(in srgb, var(--paper) 75%, transparent); font-size: 0.92rem; line-height: 1.65; }
  @media (min-width: 700px) { .trust-grid { grid-template-columns: 1fr 1fr; gap: 2.5rem 3.5rem; } }
  @media (min-width: 1040px) { .trust-grid { grid-template-columns: repeat(4, 1fr); gap: 2.5rem; } }

  .steps { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  .step { border-top: 2px solid var(--ink); padding-top: 1.1rem; }
  .step-n { font-family: var(--mono); font-size: 1.8rem; color: var(--accent); }
  .step h3 { margin: 0.6rem 0; }
  .step p { font-size: 0.95rem; }

  .two { display: grid; grid-template-columns: 1fr; gap: 3rem; }
  .proof-body { color: var(--ink-2); max-width: 56ch; line-height: 1.7; }
  .proof-honest { color: var(--ink-2); max-width: 56ch; line-height: 1.7; margin-top: 1.2rem; border-inline-start: 3px solid var(--accent); padding-inline-start: 1.2rem; }
  .why h3 { margin-bottom: 1rem; }
  .why p { color: var(--ink-2); max-width: 48ch; }
  .why .closing { margin-top: 1.5rem; font-weight: 600; color: var(--ink); }

  @media (min-width: 820px) {
    .steps { grid-template-columns: repeat(3, 1fr); }
    .two { grid-template-columns: 1.2fr 0.8fr; gap: 4rem; }
    .offer-grid { grid-template-columns: 1.15fr 0.85fr; gap: 4rem; }
  }
</style>
