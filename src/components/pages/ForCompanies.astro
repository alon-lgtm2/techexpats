---
import Nav from "../Nav.astro";
import Footer from "../Footer.astro";
import CTA from "../CTA.astro";
import { getT, localizePath, type Lang } from "../../i18n";
interface Props { lang?: Lang }
const { lang = "en" } = Astro.props;
const t = getT(lang);
const f = t.forCompanies;

const steps = [
  { n: "01", t: f.s1t, d: f.s1d },
  { n: "02", t: f.s2t, d: f.s2d },
  { n: "03", t: f.s3t, d: f.s3d },
];
const searchItems = [f.a1, f.a2, f.a3, f.a4];
const sprint = [f.b1, f.b2, f.b3, f.b4, f.b5];
const isRTL = lang === "he";
const hard = [
  { t: f.h1t, b: f.h1b }, { t: f.h2t, b: f.h2b }, { t: f.h3t, b: f.h3b },
  { t: f.h4t, b: f.h4b }, { t: f.h5t, b: f.h5b },
];
const me = [
  { t: f.m1t, b: f.m1b }, { t: f.m2t, b: f.m2b }, { t: f.m3t, b: f.m3b },
  { t: f.m4t, b: f.m4b }, { t: f.m5t, b: f.m5b },
];
const trust = [
  { l: f.t1Label, b: f.t1Body },
  { l: f.t2Label, b: f.t2Body },
  { l: f.t3Label, b: f.t3Body },
  { l: f.t4Label, b: f.t4Body },
];
---

<Nav lang={lang} />

<section class="hero section">
  <div class="container">
    <span class="eyebrow">{f.eyebrow}</span>
    <h1 class="display-xl">
      {f.h1}{isRTL ? " " : <br />}<span class="accent">{f.h2}</span>
    </h1>
    <p class="lead">{f.sub}</p>
    <div class="ctas">
      <a href={localizePath("/contact", lang)} class="btn btn-primary">{f.ctaPrimary} <span class="arrow">&rarr;</span></a>
      <a href={localizePath("/book", lang)} class="btn btn-ghost">{f.ctaSecondary}</a>
    </div>
    <p class="signature mono" dir="ltr">{f.signature}</p>
  </div>
</section>

<!-- ===== WHY THIS IS HARD IN EUROPE ===== -->
<section class="section problem-sec">
  <div class="container">
    <div class="p-head-row">
      <div>
        <span class="eyebrow">{f.hardEyebrow}</span>
        <h2 class="display-lg p-head">{f.hardHeading}</h2>
      </div>
      <p class="p-body">{f.hardIntro}</p>
    </div>
    <div class="reasons">
      {hard.map((r, i) => (
        <article class="reason">
          <span class="reason-n mono">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="reason-t">{r.t}</h3>
          <p>{r.b}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ===== THE TWO OFFERS ===== -->
<section class="section">
  <div class="container">
    <span class="eyebrow">{f.offersEyebrow}</span>
    <h2 class="display-lg sec-h">{f.offersHeading}</h2>

    <article class="offer">
      <span class="offer-tag mono" dir="auto">{f.aTag}</span>
      <h3 class="display-lg offer-h">{f.aHeading}</h3>
      <div class="offer-grid">
        <div class="offer-body">
          <div class="field">
            <span class="label k">{f.aWhoLabel}</span>
            <p>{f.aWho}</p>
          </div>
          <div class="field">
            <span class="label k">{f.aProblemLabel}</span>
            <p>{f.aProblem}</p>
          </div>
          <div class="field">
            <span class="label k">{f.aWorkLabel}</span>
            <p>{f.aWork}</p>
          </div>
        </div>
        <div class="offer-side">
          <ul class="check">{searchItems.map((w) => <li>{w}</li>)}</ul>
          <div class="terms">
            <span class="label k">{f.aTermsLabel}</span>
            <p>{f.aTerms}</p>
          </div>
        </div>
      </div>
    </article>

    <article class="offer">
      <span class="offer-tag mono" dir="auto">{f.bTag}</span>
      <h3 class="display-lg offer-h">{f.bHeading}</h3>
      <div class="offer-grid">
        <div class="offer-body">
          <div class="field">
            <span class="label k">{f.bWhoLabel}</span>
            <p>{f.bWho}</p>
          </div>
          <div class="field">
            <span class="label k">{f.bProblemLabel}</span>
            <p>{f.bProblem}</p>
          </div>
          <div class="field">
            <span class="label k">{f.bWorkLabel}</span>
            <p>{f.bWork}</p>
          </div>
        </div>
        <div class="offer-side">
          <ol class="sprint">
            {sprint.map((s, i) => (
              <li><span class="sprint-n mono">{String(i + 1).padStart(2, "0")}</span>{s}</li>
            ))}
          </ol>
          <div class="terms">
            <span class="label k">{f.bProofLabel}</span>
            <p>{f.bProof}</p>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<!-- ===== WHO YOU ARE CONTRACTING WITH ===== -->
<section class="section trust-sec">
  <div class="container">
    <div class="trust-head">
      <div>
        <span class="eyebrow">{f.trustEyebrow}</span>
        <h2 class="display-lg sec-h">{f.trustHeading}</h2>
      </div>
      <p class="kvk mono" dir="ltr">KvK 42085435</p>
    </div>
    <div class="trust-grid">
      {trust.map((t, i) => (
        <article class="trust-item">
          <span class="trust-n mono">{String(i + 1).padStart(2, "0")}</span>
          <span class="trust-l">{t.l}</span>
          <p>{t.b}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ===== HOW A SEARCH RUNS ===== -->
<section class="section alt">
  <div class="container">
    <span class="eyebrow">{f.processEyebrow}</span>
    <h2 class="display-lg sec-h">{f.processHeading}</h2>
    <div class="steps">
      {steps.map((s) => (
        <article class="step">
          <span class="step-n">{s.n}</span>
          <h3 class="display-md">{s.t}</h3>
          <p>{s.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ===== WHY ME ===== -->
<section class="section">
  <div class="container">
    <div class="me-head">
      <div>
        <span class="eyebrow">{f.meEyebrow}</span>
        <h2 class="display-lg sec-h">{f.meHeading}</h2>
      </div>
      <figure class="me-portrait">
        <img src="/alon.jpg" alt="Alon Gildoni" loading="lazy" />
        <figcaption class="mono">{f.proofEyebrow}</figcaption>
      </figure>
    </div>
    <div class="me-list">
      {me.map((r, i) => (
        <article class="me-item">
          <span class="me-n mono">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h3 class="me-t">{r.t}</h3>
            <p>{r.b}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="closing">{f.closing}</p>
  </div>
</section>

<CTA lang={lang} heading={f.ctaHeading} body={f.ctaBody} />
<Footer lang={lang} />

<style>
  .hero .display-xl .accent { color: var(--accent); }
  .hero .lead { max-width: 58ch; margin: 1.5rem 0 2rem; }
  .ctas { display: flex; gap: 0.9rem; flex-wrap: wrap; }
  .signature { margin-top: 2rem; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); }
  .signature::before { content: "// "; color: var(--accent); }
  .alt { background: var(--paper-2); }
  .sec-h { margin: 1.1rem 0 2.5rem; max-width: 22ch; }
  .k { color: var(--accent); }

  /* why this is hard in Europe */
  .problem-sec { background: var(--ink); color: var(--paper); }
  .problem-sec .eyebrow { color: color-mix(in srgb, var(--paper) 65%, transparent); }
  .p-head-row { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  .p-head { color: var(--paper); margin-top: 1.1rem; max-width: 26ch; }
  .p-body { color: color-mix(in srgb, var(--paper) 80%, transparent); font-size: 1.05rem; line-height: 1.7; align-self: end; }
  .reasons { display: grid; grid-template-columns: 1fr; gap: 2.5rem; margin-top: 3.5rem; }
  .reason { border-top: 1px solid color-mix(in srgb, var(--paper) 28%, transparent); padding-top: 1.2rem; }
  .reason-n { display: block; color: var(--accent); font-size: 0.78rem; letter-spacing: 0.14em; margin-bottom: 0.7rem; }
  .reason-t {
    font-family: var(--display); font-weight: var(--display-weight);
    font-size: 1.22rem; line-height: 1.25; color: var(--paper); margin-bottom: 0.7rem;
  }
  .reason p { color: color-mix(in srgb, var(--paper) 74%, transparent); font-size: 0.95rem; line-height: 1.7; }
  @media (min-width: 760px) {
    .p-head-row { grid-template-columns: 1fr 1fr; gap: 3.5rem; }
    .reasons { grid-template-columns: 1fr 1fr; gap: 2.75rem 4rem; }
  }
  @media (min-width: 1100px) { .reasons { grid-template-columns: repeat(3, 1fr); } }

  /* the two offers */
  .offer { border-top: 2px solid var(--ink); padding-top: 1.5rem; margin-bottom: 4rem; }
  .offer:last-child { margin-bottom: 0; }
  .offer-tag { display: block; font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); }
  .offer-h { margin: 0.8rem 0 2rem; max-width: 20ch; }
  .offer-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; }
  .field { margin-bottom: 1.6rem; }
  .field:last-child { margin-bottom: 0; }
  .field .label { display: block; margin-bottom: 0.5rem; }
  .field p { color: var(--ink-2); max-width: 58ch; line-height: 1.7; }

  .check { list-style: none; display: flex; flex-direction: column; gap: 0.8rem; }
  .check li { position: relative; padding-inline-start: 1.6rem; color: var(--ink-2); font-size: 0.95rem; }
  .check li::before { content: "+"; position: absolute; inset-inline-start: 0; color: var(--accent); font-family: var(--mono); }

  .sprint { list-style: none; display: flex; flex-direction: column; gap: 0.85rem; }
  .sprint li { display: flex; gap: 0.7rem; color: var(--ink-2); font-size: 0.95rem; align-items: baseline; }
  .sprint-n { color: var(--accent); font-size: 0.75rem; flex: none; }

  .terms { margin-top: 2rem; border-inline-start: 3px solid var(--line); padding-inline-start: 1.2rem; }
  .terms .label { display: block; margin-bottom: 0.5rem; }
  .terms p { color: var(--ink-3); font-size: 0.9rem; line-height: 1.65; }

  /* who you are contracting with */
  .trust-sec { background: var(--ink); color: var(--paper); }
  .trust-sec .eyebrow { color: color-mix(in srgb, var(--paper) 65%, transparent); }
  .trust-sec .sec-h { color: var(--paper); margin-bottom: 0; }
  .trust-head { display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: space-between; align-items: flex-end; }
  .kvk {
    font-size: 0.9rem; letter-spacing: 0.16em; color: var(--paper);
    border: 1px solid color-mix(in srgb, var(--paper) 40%, transparent);
    padding: 0.55rem 1rem;
  }
  .trust-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; margin-top: 3rem; }
  .trust-item { border-top: 1px solid color-mix(in srgb, var(--paper) 30%, transparent); padding-top: 1.1rem; }
  .trust-n { display: block; color: var(--accent); font-size: 0.75rem; letter-spacing: 0.14em; margin-bottom: 0.6rem; }
  .trust-l { display: block; color: var(--paper); font-weight: 600; margin-bottom: 0.6rem; }
  .trust-item p { color: color-mix(in srgb, var(--paper) 75%, transparent); font-size: 0.92rem; line-height: 1.65; }
  @media (min-width: 700px) { .trust-grid { grid-template-columns: 1fr 1fr; gap: 2.5rem 3.5rem; } }
  @media (min-width: 1040px) { .trust-grid { grid-template-columns: repeat(4, 1fr); gap: 2.5rem; } }

  .steps { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  .step { border-top: 2px solid var(--ink); padding-top: 1.1rem; }
  .step-n { font-family: var(--mono); font-size: 1.8rem; color: var(--accent); }
  .step h3 { margin: 0.6rem 0; }
  .step p { font-size: 0.95rem; }

  /* why me */
  .me-head { display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: end; }
  .me-head .sec-h { margin-bottom: 0; }
  .me-portrait { position: relative; max-width: 260px; justify-self: start; }
  .me-portrait img { width: 100%; aspect-ratio: 4/5; object-fit: cover; object-position: center top; filter: grayscale(1) contrast(1.04); display: block; }
  .me-portrait figcaption {
    position: absolute; bottom: 0; inset-inline-start: 0;
    background: var(--accent); color: #fff;
    font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.4rem 0.8rem;
  }
  .me-list { display: grid; grid-template-columns: 1fr; gap: 2.25rem; margin-top: 3.5rem; }
  .me-item { display: grid; grid-template-columns: 2.6rem 1fr; gap: 0.5rem; align-items: start; border-top: 1px solid var(--line); padding-top: 1.2rem; }
  .me-n { color: var(--accent); font-size: 0.78rem; letter-spacing: 0.14em; padding-top: 0.35rem; }
  .me-t { font-family: var(--display); font-weight: var(--display-weight); font-size: 1.22rem; line-height: 1.25; color: var(--ink); margin-bottom: 0.6rem; }
  .me-item p { color: var(--ink-2); font-size: 0.95rem; line-height: 1.7; }
  .closing { margin-top: 3rem; font-weight: 600; color: var(--ink); font-size: 1.15rem; }
  @media (min-width: 760px) {
    .me-head { grid-template-columns: 1fr auto; }
    .me-list { grid-template-columns: 1fr 1fr; gap: 2.5rem 4rem; }
  }

  :global([dir="rtl"]) .sec-h,
  :global([dir="rtl"]) .offer-h { max-width: 32ch; }
  :global([dir="rtl"]) .p-head { max-width: 44ch; }
  :global([dir="rtl"]) .hero .lead { max-width: 74ch; }
  :global([dir="rtl"]) .field p { max-width: 74ch; }
  /* letter-spacing and uppercase are Latin devices; on Hebrew they only
     loosen the word into unreadable pieces. */
  :global([dir="rtl"]) .offer-tag,
  :global([dir="rtl"]) .reason-n,
  :global([dir="rtl"]) .me-n,
  :global([dir="rtl"]) .label { letter-spacing: 0.02em; text-transform: none; }
  /* the signature is Latin, so it is laid out LTR, but it still has to hang
     off the right margin like everything around it. */
  :global([dir="rtl"]) .signature { text-align: right; }

  @media (min-width: 820px) {
    .steps { grid-template-columns: repeat(3, 1fr); }
    .offer-grid { grid-template-columns: 1.15fr 0.85fr; gap: 4rem; }
  }
</style>
