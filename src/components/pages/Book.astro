---
import Nav from "../Nav.astro";
import Footer from "../Footer.astro";
import { getT, type Lang, BOOKING_URL } from "../../i18n";
interface Props { lang?: Lang }
const { lang = "en" } = Astro.props;
const t = getT(lang);
const b = t.book;
const calendly = BOOKING_URL;
---

<Nav lang={lang} />

<section class="section">
  <div class="container">
    <span class="eyebrow">{b.eyebrow}</span>
    <h1 class="display-lg head">{b.heading}</h1>
    <p class="lead">{b.sub}</p>

    <div class="calendly-inline-widget" data-url={`${calendly}?hide_gdpr_banner=1&background_color=ffffff&text_color=0a0a0a&primary_color=f25c2a`} style="min-width:320px;height:680px;margin-top:2.5rem;"></div>
    <noscript>
      <a class="btn btn-primary" href={calendly} style="margin-top:2rem;">{t.nav.startSearch} &rarr;</a>
    </noscript>
  </div>
</section>

<Footer lang={lang} />

<script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>

<style>
  .head { margin: 1.1rem 0 1rem; }
  .lead { max-width: 50ch; }
</style>
