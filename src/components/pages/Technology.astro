---
import Nav from "../Nav.astro";
import Footer from "../Footer.astro";
import CTA from "../CTA.astro";
import { localizePath, type Lang } from "../../i18n";
interface Props { lang?: Lang }
const { lang = "he" } = Astro.props;

const COPY = {
  en: {
    eyebrow: "Technology",
    h1: "The technology I bring to the search.",
    sub: "AI woven through the work, sensibly and reliably. Real tools that make a deliberate search faster and sharper, never gimmicks, and never a substitute for the relationship.",
    portalTitle: "A personal portal for every candidate",
    portalBody: "Each person I work with gets a private workspace: your profile, your target companies, your next actions, and your progress, all in one place and kept current together. It is where the search lives between our sessions.",
    portalCta: "See an example portal",
    sevenKicker: "The engine",
    sevenTitle: "Seven-a-Day",
    sevenTagline: "A custom app that turns the method into a daily practice.",
    sevenBody: "Job searching done right is a discipline, not a lottery. Seven-a-Day gives that discipline a home: a focused rhythm of high-value actions each day, a pipeline of the right companies, and the momentum to keep going.",
    sevenFeatures: [
      "Seven focused actions a day, with streaks and momentum to keep you moving",
      "A company pipeline: rate, track next actions, and log every interaction",
      "A “Freezer” to park companies for a few days, and a parking lot for leads",
      "Built-in AI prompts for CV, LinkedIn, cover letters, and interview prep",
      "Curated Dutch job resources and headhunters, in one place",
    ],
    shotsLabel: "Screens",
    shots: ["Dashboard", "The daily seven", "AI-assisted outreach", "Company pipeline"],
    dirTitle: "The Israeli-companies directory",
    dirBody: "A living list of Israeli companies operating in the Netherlands and across the EU, the backbone of a target-company search and a fast way to see who can actually sponsor a visa.",
    dirCta: "Open the directory",
    aiTitle: "AI, used well",
    aiBody: "Generative tools where they genuinely help, drafting, research, preparation, and human judgment where it counts. Reliable and private, calibrated to your real situation, never a black box you have to trust blindly.",
    closeHeading: "Curious how it works in practice?",
    closeBody: "The tools are part of the work, not the whole of it. The first conversation is free and honest.",
  },
  he: {
    eyebrow: "טכנולוגיה",
    h1: "הטכנולוגיה שאני מביא לחיפוש.",
    sub: "בינה מלאכותית שזורה בעבודה, בצורה שקולה ואמינה. כלים אמיתיים שהופכים חיפוש ממוקד למהיר וחד יותר, בלי גימיקים, ובלי תחליף ליחס האישי.",
    portalTitle: "פורטל אישי לכל מועמד",
    portalBody: "כל אדם שאני עובד איתו מקבל סביבת עבודה פרטית: הפרופיל שלכם, חברות המטרה, הפעולות הבאות וההתקדמות, הכול במקום אחד ומעודכן יחד. שם החיפוש חי בין הפגישות שלנו.",
    portalCta: "לדוגמת פורטל",
    sevenKicker: "המנוע",
    sevenTitle: "שבע ביום",
    sevenTagline: "אפליקציה ייעודית שהופכת את השיטה לתרגול יומי.",
    sevenBody: "חיפוש עבודה שנעשה נכון הוא משמעת, לא הגרלה. “שבע ביום” נותן למשמעת הזו בית: קצב ממוקד של פעולות בעלות ערך בכל יום, מאגר של החברות הנכונות, והתנופה להמשיך.",
    sevenFeatures: [
      "שבע פעולות ממוקדות ביום, עם רצפים ותנופה שמחזיקים אתכם בתנועה",
      "מאגר חברות: דירוג, מעקב אחר הפעולה הבאה, ותיעוד כל אינטראקציה",
      "“פריזר” להקפאת חברות לכמה ימים, ו“מגרש חניה” לרעיונות ולידים",
      "פרומפטים מובנים ל-CV, ללינקדאין, למכתבי מקדמה ולהכנה לראיונות",
      "מקורות מומלצים לחיפוש עבודה בהולנד וחברות השמה, במקום אחד",
    ],
    shotsLabel: "מסכים",
    shots: ["לוח בקרה", "השבע היומי", "פנייה בעזרת AI", "מאגר החברות"],
    dirTitle: "מאגר החברות הישראליות",
    dirBody: "רשימה חיה של חברות ישראליות הפועלות בהולנד ובאיחוד האירופי, עמוד השדרה של חיפוש מבוסס חברות-מטרה, ודרך מהירה לראות מי באמת יכול להעניק חסות לוויזה.",
    dirCta: "פתחו את המאגר",
    aiTitle: "בינה מלאכותית, בשימוש נכון",
    aiBody: "כלים גנרטיביים במקומות שבהם הם באמת עוזרים, ניסוח, מחקר והכנה, ושיקול דעת אנושי במקומות שבהם זה קובע. אמין ופרטי, מותאם למצב האמיתי שלכם, ולא קופסה שחורה שצריך לתת בה אמון עיוור.",
    closeHeading: "סקרנים איך זה עובד בפועל?",
    closeBody: "הכלים הם חלק מהעבודה, לא כולה. השיחה הראשונה חינמית וכנה.",
  },
};

const c = COPY[lang as "en" | "he"] ?? COPY.en;
---

<Nav lang={lang} />

<section class="hero section">
  <div class="container">
    <span class="eyebrow">{c.eyebrow}</span>
    <h1 class="display-xl">{c.h1}</h1>
    <p class="lead">{c.sub}</p>
  </div>
</section>

<!-- PORTAL -->
<section class="section alt">
  <div class="container split">
    <div>
      <span class="label k">01</span>
      <h2 class="display-lg">{c.portalTitle}</h2>
      <p>{c.portalBody}</p>
      <a href={localizePath("/portal-example", lang)} class="btn btn-ghost">{c.portalCta} <span class="arrow">&rarr;</span></a>
    </div>
    <div class="mock-portal" aria-hidden="true">
      <div class="mp-bar"><span></span><span></span><span></span></div>
      <div class="mp-body">
        <div class="mp-row"><b>15+</b><i></i></div>
        <div class="mp-row"><b>7/7</b><i></i></div>
        <div class="mp-row"><i></i></div>
        <div class="mp-row"><i></i></div>
      </div>
    </div>
  </div>
</section>

<!-- SEVEN-A-DAY -->
<section class="section seven">
  <div class="container">
    <span class="label k">02 / {c.sevenKicker}</span>
    <h2 class="display-lg seven-h">{c.sevenTitle}</h2>
    <p class="seven-tag">{c.sevenTagline}</p>
    <p class="seven-body">{c.sevenBody}</p>
    <ul class="features">
      {c.sevenFeatures.map((f) => <li>{f}</li>)}
    </ul>
    <div class="shots">
      <span class="label">{c.shotsLabel}</span>
      <div class="shots-grid">
        {c.shots.map((s) => (
          <figure class="shot">
            <div class="shot-frame"></div>
            <figcaption class="label">{s}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- DIRECTORY + AI -->
<section class="section alt">
  <div class="container two">
    <article class="panel">
      <span class="label k">03</span>
      <h2 class="display-md">{c.dirTitle}</h2>
      <p>{c.dirBody}</p>
      <a href={localizePath("/resources", lang)} class="btn btn-ghost">{c.dirCta} <span class="arrow">&rarr;</span></a>
    </article>
    <article class="panel">
      <span class="label k">04</span>
      <h2 class="display-md">{c.aiTitle}</h2>
      <p>{c.aiBody}</p>
    </article>
  </div>
</section>

<CTA lang={lang} heading={c.closeHeading} body={c.closeBody} />
<Footer lang={lang} />

<style>
  .hero .lead { max-width: 56ch; margin-top: 1.5rem; }
  .alt { background: var(--paper-2); }
  .k { color: var(--accent); }

  .split { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
  .split h2 { margin: 0.8rem 0 1rem; }
  .split p { color: var(--ink-2); max-width: 44ch; margin-bottom: 1.5rem; }
  @media (min-width: 860px) { .split { grid-template-columns: 1.1fr 0.9fr; gap: 4rem; } }

  .mock-portal { border: 1px solid var(--line); background: var(--paper); }
  .mp-bar { display: flex; gap: 0.4rem; padding: 0.75rem 1rem; border-bottom: 1px solid var(--line); background: var(--ink); }
  .mp-bar span { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: rgba(255,255,255,0.35); }
  .mp-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.9rem; }
  .mp-row { display: flex; align-items: center; gap: 0.9rem; }
  .mp-row b { font-family: var(--mono); color: var(--accent); font-size: 1.1rem; min-width: 2.6rem; }
  .mp-row i { display: block; height: 0.8rem; flex: 1; background: var(--paper-2); border: 1px solid var(--line); }

  .seven-h { margin: 0.8rem 0 0.5rem; }
  .seven-tag { font-family: var(--display); font-weight: var(--display-weight); font-size: 1.3rem; color: var(--ink); margin-bottom: 1rem; }
  .seven-body { color: var(--ink-2); max-width: 60ch; margin-bottom: 2rem; }
  .features { list-style: none; display: grid; grid-template-columns: 1fr; gap: 0.8rem; margin-bottom: 3rem; }
  .features li { position: relative; padding-inline-start: 1.6rem; color: var(--ink-2); }
  .features li::before { content: "+"; position: absolute; inset-inline-start: 0; color: var(--accent); font-family: var(--mono); }
  @media (min-width: 760px) { .features { grid-template-columns: 1fr 1fr; gap: 0.8rem 2.5rem; } }

  .shots .label { display: block; margin-bottom: 1rem; }
  .shots-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .shot { margin: 0; }
  .shot-frame { aspect-ratio: 16/10; border: 1px solid var(--line); background: linear-gradient(135deg, var(--paper-2), var(--paper)); position: relative; }
  .shot-frame::after { content: ""; position: absolute; inset: 0; background-image: radial-gradient(circle, var(--line) 1px, transparent 1px); background-size: 16px 16px; opacity: 0.5; }
  .shot figcaption { margin-top: 0.5rem; }
  @media (min-width: 760px) { .shots-grid { grid-template-columns: repeat(4, 1fr); } }

  .two { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  .panel { border: 1px solid var(--line); background: var(--paper); padding: 1.75rem; display: flex; flex-direction: column; gap: 0.8rem; align-items: flex-start; }
  .panel h2 { margin: 0.4rem 0; }
  .panel p { color: var(--ink-2); margin-bottom: 0.8rem; }
  @media (min-width: 760px) { .two { grid-template-columns: 1fr 1fr; gap: 1.5rem; } }
</style>
