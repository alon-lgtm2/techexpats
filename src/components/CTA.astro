---
import { getT, whatsappUrl, type Lang } from "../i18n";
interface Props { lang?: Lang; heading?: string; body?: string }
const { lang = "en", heading, body } = Astro.props;
const t = getT(lang);
---

<section class="cta-band">
  <div class="container">
    <span class="eyebrow">{t.cta.eyebrow}</span>
    <div class="cta-inner">
      <div>
        <h2 class="display-lg">{heading ?? t.cta.heading}</h2>
        <p>{body ?? t.cta.body}</p>
      </div>
      <div class="cta-actions">
        <a href={whatsappUrl(lang)} target="_blank" rel="noopener" class="btn btn-primary wa">
          <svg class="wa-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.45 1.33 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.5 0 9.96-4.46 9.96-9.96S17.54 2 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.8-.23-.09-.39-.13-.56.12-.16.25-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.48-1.38-1.73-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.86.84-.86 2.05 0 1.21.88 2.38 1 2.54.12.16 1.74 2.65 4.2 3.72.59.25 1.05.4 1.4.51.59.19 1.13.16 1.55.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z"/></svg>
          {t.cta.talk}
        </a>
        <a href={`mailto:${t.cta.email}`} class="btn btn-ghost">{t.cta.email}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band { background: var(--paper-2); border-top: 1px solid var(--line); padding-block: clamp(3.5rem, 7vw, 6rem); }
  .eyebrow { margin-bottom: 1.5rem; }
  .cta-inner { display: flex; flex-direction: column; gap: 2rem; align-items: flex-start; }
  .cta-inner .display-lg { max-width: 18ch; }
  .cta-inner p { color: var(--ink-2); max-width: 48ch; margin-top: 1rem; }
  .cta-actions { display: flex; gap: 0.9rem; flex-wrap: wrap; }
  .btn.wa { display: inline-flex; align-items: center; gap: 0.5rem; }
  .wa-icon { width: 1.15em; height: 1.15em; fill: currentColor; flex: none; }
  @media (min-width: 820px) {
    .cta-inner { flex-direction: row; justify-content: space-between; align-items: flex-end; }
  }
</style>
