---
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import Testimonials from "./Testimonials.astro";
import ProofWall from "./ProofWall.astro";
import HiringCalendar from "./HiringCalendar.astro";
import CTA from "./CTA.astro";
import { getCollection } from "astro:content";
import { getT, localizePath, type Lang } from "../i18n";

interface Props { lang?: Lang }
const { lang = "en" } = Astro.props;
const t = getT(lang);

const stats = [
  { v: t.hero.stat1Value, l: t.hero.stat1Label },
  { v: t.hero.stat2Value, l: t.hero.stat2Label },
  { v: t.hero.stat3Value, l: t.hero.stat3Label },
  { v: t.hero.stat4Value, l: t.hero.stat4Label },
];
const pillars = [
  { n: t.pillars.n1, title: t.pillars.t1, body: t.pillars.d1, accent: t.pillars.a1 },
  { n: t.pillars.n2, title: t.pillars.t2, body: t.pillars.d2, accent: t.pillars.a2 },
  { n: t.pillars.n3, title: t.pillars.t3, body: t.pillars.d3, accent: t.pillars.a3 },
];
const services = [
  { t: t.spec.t1, d: t.spec.d1 }, { t: t.spec.t2, d: t.spec.d2 },
  { t: t.spec.t3, d: t.spec.d3 }, { t: t.spec.t4, d: t.spec.d4 },
  { t: t.spec.t5, d: t.spec.d5 }, { t: t.spec.t6, d: t.spec.d6 },
];
const steps = [
  { n: "01", title: t.approach.s1title, body: t.approach.s1body },
  { n: "02", title: t.approach.s2title, body: t.approach.s2body },
  { n: "03", title: t.approach.s3title, body: t.approach.s3body },
];
const allArticles = await getCollection("insights");
const latest = allArticles
  .filter((a) => a.data.lang === lang && (a.data.audience === "individuals" || a.data.audience === "both"))
  .sort((x, y) => +new Date(y.data.date) - +new Date(x.data.date))
  .slice(0, 3);

const ticker = "SINCE 2018 — AMSTERDAM & EUROPE — EN · NL · HE — CAREER COACHING + HEADHUNTING — ";
---

<Nav lang={lang} />

<!-- ===== TICKER ===== -->
<div class="ticker"><div class="ticker-track">{ticker.repeat(3)}</div></div>

<!-- ===== HERO ===== -->
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow rise">{t.hero.eyebrow}</span>
      <h1 class="display-xl rise" style="animation-delay:.1s">
        <span class="hl">{t.hero.headline1}</span>
        <span class="hl accent">{t.hero.headline2}</span>
        {t.hero.headline3 && <span class="hl">{t.hero.headline3}</span>}
      </h1>
      <p class="lead rise" style="animation-delay:.25s">{t.hero.sub}</p>
      <div class="hero-ctas rise" style="animation-delay:.4s">
        <a href={localizePath("/book", lang)} class="btn btn-primary">{t.cta.book} <span class="arrow">&rarr;</span></a>
        <a href={localizePath("/career-advice", lang)} class="btn btn-ghost">{t.hero.ctaCandidate}</a>
        <a href={localizePath("/for-companies", lang)} class="hiring-link">{t.hero.ctaEmployer} <span class="arrow">&rarr;</span></a>
      </div>
    </div>
    <div class="hero-portrait rise" style="animation-delay:.3s">
      <img src="/alon.jpg" alt="Alon Gildoni" />
      <span class="portrait-tag">ALON GILDONI / FOUNDER</span>
    </div>
  </div>
  <div class="container">
    <div class="stat-row">
      {stats.map((s, i) => (
        <div class="stat">
          <span class="stat-i label">{String(i + 1).padStart(2, "0")}</span>
          <span class="stat-v display-md">{s.v}</span>
          <span class="label">{s.l}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===== TRACK RECORD ===== -->
<section class="section track">
  <div class="container">
    <span class="eyebrow">{t.track.eyebrow}</span>
    <h2 class="display-lg sec-h">{t.track.heading}</h2>
    <p class="sec-sub">{t.track.sub}</p>

    <div class="track-grid">
      <div class="metrics">
        <div class="metric">
          <div class="metric-top">
            <span class="metric-v display-md">{t.track.m1Value}</span>
            <span class="metric-l">{t.track.m1Label}</span>
          </div>
          <div class="bar"><span class="bar-fill" style="width:70%"></span></div>
        </div>
        <div class="metric">
          <div class="metric-top">
            <span class="metric-v display-md">{t.track.m2Value}</span>
            <span class="metric-l">{t.track.m2Label}</span>
          </div>
          <div class="bar"><span class="bar-fill alt" style="width:85%"></span></div>
        </div>
      </div>

      <div class="split-card">
        <span class="label">{t.track.splitLabel}</span>
        <div class="split-bar">
          <span class="seg seg-tech" style="width:50%"><i>{t.track.splitTech}</i></span>
          <span class="seg seg-nontech" style="width:50%"><i>{t.track.splitNonTech}</i></span>
        </div>
        <p class="split-note">{t.track.splitNote}</p>
      </div>
    </div>

    <div class="track-foot">
      <div class="foot-item">
        <span class="label k">{t.track.selectLabel}</span>
        <p>{t.track.selectNote}</p>
      </div>
      <div class="foot-item disclaimer">
        <span class="label">{t.track.disclaimerLabel}</span>
        <p>{t.track.disclaimer}</p>
      </div>
    </div>
  </div>
</section>

<HiringCalendar lang={lang} />

<!-- ===== PILLARS ===== -->
<section class="section alt">
  <div class="container">
    <span class="eyebrow">{t.pillars.eyebrow}</span>
    <h2 class="display-lg sec-h">{t.pillars.heading}</h2>
    <div class="pillars">
      {pillars.map((p) => (
        <article class="pillar">
          <span class="pillar-n">{p.n}</span>
          <h3 class="display-md">{p.title}</h3>
          <p>{p.body}</p>
          <span class="pillar-accent">{p.accent}</span>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ===== PHOTO BAND =====
     The homepage carried exactly one photograph, the hero headshot, and nothing
     else in eight screens of text (Alon, 2026-09-04: "make sure that the site
     has photos of mine ... photos of me working"). This is the only publishable
     working photograph that exists; see public/README.md for what is missing
     and where to put it. -->
<figure class="photoband">
  <img src="/alon-speaking.jpg" alt={t.photoband.caption} width="1600" height="554" loading="lazy" />
  <figcaption class="container">
    <span class="eyebrow">{t.photoband.eyebrow}</span>
    <p>{t.photoband.caption}</p>
  </figcaption>
</figure>

<!-- ===== EMPLOYERS ===== -->
<section class="section employers">
  <div class="container">
    <div class="emp-head">
      <div>
        <span class="eyebrow">{t.employers.eyebrow}</span>
        <h2 class="display-lg sec-h">{t.employers.heading}</h2>
      </div>
      <p class="emp-sub">{t.employers.sub}</p>
    </div>
    <div class="offers">
      <article class="offer">
        <span class="offer-n">{t.employers.o1Label}</span>
        <h3 class="display-md">{t.employers.o1Title}</h3>
        <p>{t.employers.o1Body}</p>
      </article>
      <article class="offer">
        <span class="offer-n">{t.employers.o2Label}</span>
        <h3 class="display-md">{t.employers.o2Title}</h3>
        <p>{t.employers.o2Body}</p>
      </article>
    </div>
    <div class="emp-ctas">
      <a href={localizePath("/for-companies", lang)} class="btn btn-primary">{t.employers.cta} <span class="arrow">&rarr;</span></a>
      <a href={localizePath("/hiring-insights", lang)} class="btn btn-ghost">{t.employers.read}</a>
    </div>
  </div>
</section>

<!-- ===== SERVICES ===== -->
<section class="section">
  <div class="container">
    <span class="eyebrow">{t.spec.eyebrow}</span>
    <h2 class="display-lg sec-h">{t.spec.heading}</h2>
    <p class="sec-sub">{t.spec.sub}</p>
    <div class="services">
      {services.map((s, i) => (
        <article class="service">
          <span class="service-n label">{String(i + 1).padStart(2, "0")}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ===== APPROACH ===== -->
<section class="section alt">
  <div class="container">
    <span class="eyebrow">{t.approach.eyebrow}</span>
    <h2 class="display-lg sec-h">{t.approach.heading}</h2>
    <p class="sec-sub">{t.approach.body}</p>
    <div class="steps">
      {steps.map((s) => (
        <article class="step">
          <span class="step-n">{s.n}</span>
          <h3 class="display-md">{s.title}</h3>
          <p>{s.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ===== WRITING (sneak peek) ===== -->
{latest.length > 0 && (
  <section class="section writing">
    <div class="container">
      <div class="writing-head">
        <div>
          <span class="eyebrow">{t.insights.eyebrow}</span>
          <h2 class="display-lg sec-h">{t.insights.heading}</h2>
        </div>
        <a href={localizePath("/career-advice", lang)} class="all label">{t.insights.all} <span class="arrow">&rarr;</span></a>
      </div>
      <div class="wgrid">
        {latest.map((a) => (
          <a href={`/insights/${a.id}`} class="wcard">
            {a.data.image && <span class="wthumb"><img src={a.data.image} alt="" loading="lazy" /></span>}
            <span class="wmeta">
              <span class="label k">{a.data.category}</span>
              {a.data.readTime && <span class="label">{a.data.readTime}</span>}
            </span>
            <h3>{a.data.title}</h3>
            <p>{a.data.excerpt}</p>
            <span class="wread">{t.insights.read} <span class="arrow">&rarr;</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<Testimonials lang={lang} limit={6} />
<ProofWall lang={lang} limit={6} />
<CTA lang={lang} />
<Footer lang={lang} />

<style>
  /* ticker */
  .ticker { background: var(--ink); color: var(--paper); overflow: hidden; white-space: nowrap; border-bottom: 1px solid var(--ink); }
  /* On a dark direction the ink/paper flip turns this into a bright white band
     under the nav, which is far more shout than a running tape should be. */
  :global([data-theme="instrument"]) .ticker { background: var(--paper-2); color: var(--ink-3); border-bottom-color: var(--line); }
  .ticker-track {
    display: inline-block; padding: 0.5rem 0;
    font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.16em;
  }
  .ticker-track::before { content: "// "; color: var(--accent); }

  /* hero */
  .hero { padding-top: clamp(2.5rem, 5vw, 4rem); padding-bottom: clamp(2.5rem, 4vw, 3.5rem); }
  .hero-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
  /* Each headline line is its own block. It used to be one text flow broken by
     a hard <br>, which meant a line too long for the column wrapped and left a
     single word stranded underneath: in Hebrew the h1 read "היכולת שלך / אף פעם
     לא הייתה / הבעיה." Balanced per line, that cannot happen. */
  .hero-copy .display-xl .hl { display: block; text-wrap: balance; }
  .hero-copy .display-xl .accent { color: var(--accent); }
  .hero-copy .lead { margin: 1.8rem 0 2.2rem; max-width: 46ch; }
  .hero-ctas { display: flex; gap: 0.9rem; flex-wrap: wrap; }
  .hero-portrait { position: relative; }
  .hero-portrait img { width: 100%; aspect-ratio: 4/5; object-fit: cover; object-position: center top; filter: grayscale(1) contrast(1.04); border-radius: var(--radius); }
  /* Both photographs were shot on light grounds, and against graphite the
     backdrop glares brighter than any text on the page. */
  :global([data-theme="instrument"]) .hero-portrait img { filter: grayscale(1) contrast(1.08) brightness(0.82); }
  :global([data-theme="instrument"]) .photoband img { filter: grayscale(1) contrast(1.06) brightness(0.72); }
  .portrait-tag {
    position: absolute; bottom: 0; inset-inline-start: 0; background: var(--accent); color: var(--on-accent);
    font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.12em; padding: 0.45rem 0.85rem;
  }
  .stat-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem 2rem; margin-top: 2.4rem; padding-top: 1.6rem; border-top: 2px solid var(--ink); }
  .stat { display: flex; flex-direction: column; gap: 0.3rem; }
  .stat-i { color: var(--accent); }
  .stat-v { color: var(--ink); }
  @media (min-width: 720px) { .stat-row { grid-template-columns: repeat(4, 1fr); } }
  @media (min-width: 860px) { .hero-grid { grid-template-columns: 1.5fr 0.85fr; gap: 4rem; } }

  /* track record */
  .track-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; margin-top: 1rem; }
  .metrics { display: flex; flex-direction: column; gap: 2rem; }
  .metric-top { display: flex; align-items: baseline; gap: 0.8rem; margin-bottom: 0.7rem; flex-wrap: wrap; }
  .metric-v { color: var(--accent); }
  .metric-l { color: var(--ink-2); font-size: 0.95rem; }
  .bar { height: 0.7rem; background: var(--paper-2); border: 1px solid var(--line); overflow: hidden; }
  .bar-fill { display: block; height: 100%; background: var(--accent); }
  .bar-fill.alt { background: var(--ink); }
  .split-card { border: 1px solid var(--line); background: var(--paper); padding: 1.5rem; }
  .split-card > .label { display: block; margin-bottom: 1rem; }
  .split-bar { display: flex; height: 3rem; border: 1px solid var(--line); overflow: hidden; }
  .seg { display: flex; align-items: center; justify-content: center; }
  .seg i { font-style: normal; font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.05em; text-transform: uppercase; text-align: center; padding: 0 0.3rem; line-height: 1.2; }
  /* The bar is only 3rem tall, so the Hebrew label cannot grow without limit,
     but 0.6rem mono with tracking was well past unreadable. */
  :global([dir="rtl"]) .seg i {
    font-family: var(--body); font-size: 0.82rem;
    letter-spacing: 0; text-transform: none; padding: 0 0.5rem;
  }
  .seg-tech { background: var(--ink); color: var(--paper); }
  .seg-nontech { background: var(--accent); color: var(--on-accent); }
  .split-note { color: var(--ink-2); font-size: 0.9rem; margin-top: 1rem; }
  .track-foot { display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-top: 2rem; padding-top: 1.6rem; border-top: 1px solid var(--line); }
  .foot-item p { color: var(--ink-2); font-size: 0.92rem; margin-top: 0.5rem; max-width: 48ch; }
  .foot-item .k { color: var(--accent); }
  .foot-item.disclaimer { border-inline-start: 3px solid var(--line); padding-inline-start: 1.2rem; }
  .foot-item.disclaimer p { color: var(--ink-3); font-style: italic; }
  @media (min-width: 860px) { .track-grid { grid-template-columns: 1.2fr 0.8fr; gap: 3.5rem; align-items: start; } }
  @media (min-width: 760px) { .track-foot { grid-template-columns: 1fr 1fr; gap: 2.5rem; } }

  /* shared section heads */
  .alt { background: var(--paper-2); }
  .sec-h { margin: 0.9rem 0 0.7rem; max-width: 20ch; }
  .sec-sub { color: var(--ink-2); max-width: 54ch; margin-bottom: var(--sec-gap); }

  /* pillars */
  .pillars { display: grid; grid-template-columns: 1fr; gap: 2.25rem; margin-top: var(--sec-gap); }
  .pillar { border-top: 2px solid var(--ink); padding-top: 1.25rem; }
  .pillar-n { font-family: var(--mono); font-size: 2rem; font-weight: 500; color: var(--accent); display: block; margin-bottom: 0.75rem; }
  .pillar h3 { margin-bottom: 0.75rem; }
  .pillar p { font-size: 0.96rem; }
  .pillar-accent { display: block; margin-top: 1rem; font-weight: 600; color: var(--ink); font-size: 0.92rem; }
  @media (min-width: 820px) { .pillars { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; } }

  /* photo band */
  /* Not var(--ink): on a dark direction that flips to a light slab behind a
     photograph whose caption is always white over a dark gradient. The image
     covers it in every case, so it is a fixed dark placeholder. */
  .photoband { margin: 0; position: relative; background: #0c0c0c; }
  .photoband img { width: 100%; height: auto; aspect-ratio: 1600 / 554; object-fit: cover; filter: grayscale(1) contrast(1.06) brightness(0.92); }
  .photoband figcaption { position: absolute; inset-inline: 0; bottom: 0; padding-block: 1.4rem; }
  .photoband figcaption::before {
    content: ""; position: absolute; inset: -3rem 0 0 0; pointer-events: none;
    background: linear-gradient(to top, rgba(0,0,0,0.82), rgba(0,0,0,0));
  }
  .photoband .eyebrow { position: relative; color: color-mix(in srgb, #fff 70%, transparent); }
  .photoband p { position: relative; color: #fff; margin-top: 0.5rem; max-width: 56ch; font-size: 0.95rem; line-height: 1.6; }
  @media (max-width: 640px) { .photoband img { aspect-ratio: 4 / 3; } .photoband p { font-size: 0.86rem; } }

  /* employers */
  .employers { background: var(--ink); color: var(--paper); }
  .employers .eyebrow { color: color-mix(in srgb, var(--paper) 65%, transparent); }
  .employers .sec-h { color: var(--paper); }
  .emp-head { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  .emp-sub { color: color-mix(in srgb, var(--paper) 78%, transparent); max-width: 52ch; line-height: 1.65; }
  .offers { display: grid; grid-template-columns: 1fr; gap: 2.25rem; margin: var(--sec-gap) 0 2rem; }
  .offer { border-top: 2px solid color-mix(in srgb, var(--paper) 35%, transparent); padding-top: 1.25rem; }
  .offer-n { font-family: var(--mono); font-size: 2rem; color: var(--accent); display: block; margin-bottom: 0.75rem; }
  .offer h3 { color: var(--paper); margin-bottom: 0.75rem; }
  .offer p { color: color-mix(in srgb, var(--paper) 75%, transparent); font-size: 0.96rem; }
  .emp-ctas { display: flex; gap: 0.9rem; flex-wrap: wrap; }
  .employers .btn-ghost { border-color: color-mix(in srgb, var(--paper) 35%, transparent); color: var(--paper); }
  .employers .btn-ghost:hover { border-color: var(--paper); }
  @media (min-width: 820px) {
    .emp-head { grid-template-columns: 1fr 1fr; gap: 3rem; align-items: end; }
    .offers { grid-template-columns: 1fr 1fr; gap: 3.5rem; }
  }

  /* the hero's employer route, deliberately quieter than the two buttons */
  .hiring-link {
    display: inline-flex; align-items: center; gap: 0.35rem; align-self: center;
    font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .hiring-link:hover { color: var(--accent); }

  /* services */
  .services { display: grid; grid-template-columns: 1fr; gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .service { background: var(--paper); padding: 1.75rem; display: flex; flex-direction: column; gap: 0.6rem; transition: background .2s ease; }
  .service:hover { background: var(--paper-2); }
  .service-n { color: var(--accent); }
  .service h3 { font-family: var(--display); font-weight: var(--display-weight); font-size: 1.2rem; letter-spacing: -0.01em; color: var(--ink); }
  .service p { font-size: 0.92rem; }
  @media (min-width: 640px) { .services { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 980px) { .services { grid-template-columns: 1fr 1fr 1fr; } }

  /* steps */
  .steps { display: grid; grid-template-columns: 1fr; gap: 2rem; margin-top: 1rem; }
  .step { border-inline-start: 2px solid var(--accent); padding-inline-start: 1.25rem; }
  .step-n { font-family: var(--mono); font-size: 0.8rem; color: var(--accent); letter-spacing: 0.1em; }
  .step h3 { margin: 0.5rem 0 0.6rem; }
  .step p { font-size: 0.95rem; max-width: 34ch; }
  @media (min-width: 820px) { .steps { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }

  /* writing sneak peek */
  .writing-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; margin-bottom: var(--sec-gap); flex-wrap: wrap; }
  .writing-head .sec-h { margin: 1.1rem 0 0; }
  .writing-head .all { color: var(--accent); white-space: nowrap; }
  .writing-head .all:hover { color: var(--accent-ink); }
  .wgrid { display: grid; grid-template-columns: 1fr; gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .wcard { background: var(--paper); padding: 1.5rem; display: flex; flex-direction: column; gap: 0.7rem; transition: background .2s ease; }
  .wcard:hover { background: var(--paper-2); }
  .wthumb { display: block; aspect-ratio: 16/9; overflow: hidden; margin: -1.5rem -1.5rem 0.5rem; border-bottom: 1px solid var(--line); }
  .wthumb img { width: 100%; height: 100%; object-fit: cover; }
  .wmeta { display: flex; gap: 1rem; align-items: center; }
  .wmeta .k { color: var(--accent); }
  .wcard h3 { font-family: var(--display); font-weight: var(--display-weight); font-size: 1.2rem; line-height: 1.2; letter-spacing: -0.01em; color: var(--ink); }
  .wcard p { font-size: 0.9rem; color: var(--ink-2); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .wread { margin-top: auto; padding-top: 0.4rem; font-family: var(--mono); font-size: 0.8rem; color: var(--ink-3); }
  @media (min-width: 760px) { .wgrid { grid-template-columns: 1fr 1fr 1fr; } }
</style>
