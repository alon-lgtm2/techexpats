---
import "../styles/global.css";
import { isRTL, type Lang } from "../i18n";
import { alternatesFor } from "../i18n/routes";
import Analytics from "../components/Analytics.astro";

export interface Props {
  title?: string;
  description?: string;
  theme?: "editorial" | "engine" | "sun" | "slate" | "instrument";
  lang?: Lang;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  /**
   * Structured data for this page, emitted as application/ld+json. Search
   * engines use it to understand what the page IS (an article, a business, a
   * person) rather than inferring it from the markup. Added 2026-09-03: the
   * site had canonical, hreflang and og tags but no schema.org at all.
   */
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Locale alternates for this page, as { en, nl, he } root-relative paths.
   * Only pass this when the page genuinely exists in those locales, otherwise
   * hreflang would advertise URLs that 404. Emits hreflang + x-default (English).
   */
  alternates?: Partial<Record<Lang, string>>;
}
const {
  title = "TechExpats — Career Moves, led by Alon Gildoni",
  description = "Career coaching and headhunting across Europe. A deliberate search: not just a job, the job. By Alon Gildoni, Amsterdam.",
  // "instrument" since 2026-09-04, chosen by Alon from three rendered
  // directions. "engine" (white, Space Grotesk, Dutch orange) is the previous
  // default and is still a working direction; /designs switches between all five.
  theme = "instrument",
  lang = "en",
  ogImage,
  ogType = "website",
  noindex = false,
  alternates,
  jsonld,
} = Astro.props;

const ogImageAbs = ogImage ? new URL(ogImage, Astro.site).href : undefined;

// Canonical: tells search engines which URL is the real one, so the same page
// reached with a trailing slash, query string or www variant is not treated as
// duplicate content.
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// hreflang: tells search engines these are the same page in different languages,
// so an English searcher is shown the English home page rather than the Hebrew one.
// x-default points at English, which is the site default (astro.config: defaultLocale 'en').
// Only the three home pages ever passed `alternates` by hand, so 67 of the 70
// pages shipped with no hreflang at all. It is derived from the route table now,
// and an explicit prop still wins for pages the table cannot know about, such as
// the article detail route.
const resolvedAlternates = alternates ?? alternatesFor(Astro.url.pathname);
const altEntries = resolvedAlternates
  ? Object.entries(resolvedAlternates).map(([l, p]) => [l, new URL(p as string, Astro.site).href] as const)
  : [];

const dir = isRTL(lang) ? "rtl" : "ltr";
---

<!doctype html>
<html lang={lang} dir={dir} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && altEntries.map(([l, href]) => <link rel="alternate" hreflang={l} href={href} />)}
    {!noindex && altEntries.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={resolvedAlternates?.en ? new URL(resolvedAlternates.en, Astro.site).href : canonical} />
    )}
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {ogImageAbs && <meta property="og:image" content={ogImageAbs} />}
    {ogImageAbs && <meta name="twitter:card" content="summary_large_image" />}
    {ogImageAbs && <meta name="twitter:image" content={ogImageAbs} />}

    {!noindex && jsonld && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonld)} />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&family=Heebo:wght@300;400;500;600;700;800&family=Rubik:wght@400;500;600;700;800&family=Assistant:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>
