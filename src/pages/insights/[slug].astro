---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/CTA.astro";
import { getT, localizePath, type Lang } from "../../i18n";

export async function getStaticPaths() {
  const all = await getCollection("insights");
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const lang = (entry.data.lang ?? "en") as Lang;
const t = getT(lang);
const { Content } = await render(entry);
const backHref = entry.data.audience === "companies" ? "/hiring-insights" : "/career-advice";
const dateStr = entry.data.date;
---

<Base lang={lang} title={`${entry.data.title} — TechExpats`} description={entry.data.excerpt}>
  <Nav lang={lang} />

  <article class="section">
    <div class="container narrow">
      <a href={localizePath(backHref, lang)} class="back label">&larr; {t.insights.all}</a>
      <span class="meta">
        <span class="label k">{entry.data.category}</span>
        {entry.data.readTime && <span class="label">{entry.data.readTime}</span>}
      </span>
      <h1 class="display-lg title">{entry.data.title}</h1>
      <p class="byline label">{t.insights.by} &middot; {dateStr}</p>
      {entry.data.image && <img class="hero-img" src={entry.data.image} alt="" />}
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <CTA lang={lang} />
  <Footer lang={lang} />
</Base>

<style>
  .narrow { max-width: 46rem; }
  .back { display: inline-block; margin-bottom: 2rem; color: var(--ink-3); }
  .back:hover { color: var(--accent); }
  .meta { display: flex; gap: 1rem; }
  .k { color: var(--accent); }
  .title { margin: 1rem 0 1rem; }
  .byline { color: var(--ink-3); margin-bottom: 2rem; }
  .hero-img { width: 100%; aspect-ratio: 16/9; object-fit: cover; margin-bottom: 2.5rem; border: 1px solid var(--line); }

  .prose { font-size: 1.05rem; line-height: 1.75; color: var(--ink-2); }
  .prose :global(p) { margin-bottom: 1.3rem; }
  .prose :global(h2) { font-family: var(--display); font-weight: var(--display-weight); font-size: 1.7rem; letter-spacing: -0.015em; color: var(--ink); margin: 2.5rem 0 1rem; }
  .prose :global(h3) { font-family: var(--display); font-weight: var(--display-weight); font-size: 1.3rem; color: var(--ink); margin: 2rem 0 0.8rem; }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .prose :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.3rem 1.2rem; }
  .prose :global(li) { margin-bottom: 0.5rem; }
  .prose :global(blockquote) { border-inline-start: 3px solid var(--accent); padding-inline-start: 1.2rem; margin: 1.5rem 0; font-style: italic; color: var(--ink); }
  .prose :global(img) { width: 100%; margin: 1.5rem 0; border: 1px solid var(--line); }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 2rem 0; }
</style>
