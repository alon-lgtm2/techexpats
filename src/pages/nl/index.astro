---
import Base from "../../layouts/Base.astro";
import Home from "../../components/Home.astro";
const alternates = { en: "/", nl: "/nl/", he: "/he/" };
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    name: "TechExpats",
    url: "https://techexpats.nl/",
    description: "Career coaching and headhunting across Europe, with the Dutch job market as the specialism.",
    areaServed: [{ "@type": "Country", name: "Netherlands" }, { "@type": "Place", name: "Europe" }],
    address: { "@type": "PostalAddress", addressLocality: "Amsterdam", addressCountry: "NL" },
    founder: { "@type": "Person", name: "Alon Gildoni" },
    knowsLanguage: ["en", "nl", "he"],
    sameAs: ["https://israelis.nl"],
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Alon Gildoni",
    url: "https://techexpats.nl/about/",
    jobTitle: "Career coach and headhunter",
    worksFor: { "@type": "Organization", name: "TechExpats" },
    homeLocation: { "@type": "Place", name: "Amsterdam, Netherlands" },
    knowsAbout: [
      "Dutch job market",
      "hiring in the Netherlands",
      "highly skilled migrant permit",
      "the 30% ruling",
      "career coaching",
      "technical recruitment",
    ],
  },
];

---
<Base lang="nl" title="TechExpats - Vind de baan, niet zomaar werk" description="Loopbaancoaching en headhunting in Nederland en Europa, vanuit Amsterdam. Hoe werkgevers hier echt werven, en wat een zoektocht naar werk daadwerkelijk in beweging brengt. Alon Gildoni." alternates={alternates} jsonld={jsonld}>
  <Home lang="nl" />
</Base>
