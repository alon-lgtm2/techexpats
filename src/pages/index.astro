---
import Base from "../layouts/Base.astro";
import { business, person } from "../data/schema";
import Home from "../components/Home.astro";
const alternates = { he: "/", nl: "/nl/", en: "/en/" };
const jsonld = [business("he"), person("he")];

---
<Base lang="he" title="TechExpats - למצוא את העבודה, לא סתם עבודה" description="ליווי קריירה והשמה בכירה בהולנד ובאירופה, מאמסטרדם. המומחיות שלי היא שוק העבודה ההולנדי: איך מעסיקים כאן מגייסים, ומה באמת מזיז חיפוש עבודה. אלון גילדוני." alternates={alternates} jsonld={jsonld}>
  <Home lang="he" />
</Base>
