# Optional overrides for src/analytics.ts. Neither is a secret: both end up in
# the page HTML. They exist so the tokens can be set on the host instead of in
# git if that is ever preferred. Copy to .env to use locally.

# Cloudflare Web Analytics beacon token (cookieless, no consent banner needed).
PUBLIC_CF_BEACON_TOKEN=

# GA4 measurement id, e.g. G-XXXXXXXXXX. Only set this alongside a consent banner.
PUBLIC_GA4_ID=
